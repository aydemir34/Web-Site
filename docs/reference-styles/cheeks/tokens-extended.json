      "$value": "4px",
      "$type": "dimension"
    },
    "scale": [
      "4px",
      "8px",
      "10px",
      "12px",
      "16px",
      "20px",
      "24px",
      "32px",
      "40px",
      "52px",
      "80px"
    ]
  },
  "radius": {
    "none": {
      "$value": "0px",
      "$type": "dimension",
      "$description": "Cards/containers/buttons sharp modern aesthetic"
    },
    "interactive": {
      "$value": "3px",
      "$type": "dimension",
      "$description": "Inputs/buttons subtle softness"
    },
    "modal": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Secondary floating surfaces"
    }
