---
import type { Business, ServiceItem } from "../types";
import { getServiceMediaGallery } from "../lib/assets";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import { slugify } from "../lib/slugify";
import EditorialVisualFallback from "./EditorialVisualFallback.astro";

type Props = {
  business: Business;
  service: ServiceItem;
  index: number;
};

const { business, service, index } = Astro.props;
const mediaGallery = getServiceMediaGallery(business, service, 3);
const media = mediaGallery[0] ?? null;
const serviceId = slugify(service.name);
const waUrl = buildWhatsAppUrl(business, service);
---

<article id={serviceId} class="service-row">
  <p class="order">{String(index + 1).padStart(2, "0")}</p>
  <div class="service-copy">
    <h3>{service.name}</h3>
    <p>{service.description}</p>
    <a class="wa-link" href={waUrl} target="_blank" rel="noreferrer">Bu Hizmet İçin Bilgi Alın</a>
  </div>
  <figure class="service-media">
    {
      media ? (
        <>
          {mediaGallery.map((_, i) => <input type="radio" name={`gallery-${serviceId}`} id={`${serviceId}-tab-${i}`} checked={i === 0} />)}
          {mediaGallery.map((item, i) => (
            <img
              class={`media-shot media-shot-${i}`}
              src={item}
              alt={`${service.name} hizmet görseli ${i + 1}`}
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
            />
          ))}
          {
            mediaGallery.length > 1 && (
              <div class="media-tabs" role="tablist" aria-label={`${service.name} görselleri`}>
                {mediaGallery.map((_, i) => <label for={`${serviceId}-tab-${i}`}>Görünüm {i + 1}</label>)}
              </div>
            )
          }
          <div class="fallback" aria-hidden="true">
            <EditorialVisualFallback theme={business.themeId} aspectRatio="1/1" labels={["Gelin", "Kına", "Nişan"]} />
          </div>
        </>
      ) : (
        <EditorialVisualFallback theme={business.themeId} aspectRatio="1/1" labels={["Gelin", "Kına", "Nişan"]} />
      )
    }
  </figure>
</article>

<style>
  .service-row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(260px, 420px);
    gap: 0.9rem 1.1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--primary), white 72%);
  }

  .order {
    font-size: 0.74rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    padding-top: 0.2rem;
  }

  .service-copy {
    display: grid;
    gap: 0.42rem;
  }

  .service-copy h3 {
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
  }

  .service-copy p {
    color: var(--muted);
    max-width: 62ch;
  }

  .wa-link {
    margin-top: 0.25rem;
    justify-self: start;
    text-decoration: none;
    font-size: 0.76rem;
    border: 1px solid color-mix(in srgb, #25d366, black 16%);
    color: #157347;
    background: color-mix(in srgb, #25d366, white 90%);
    border-radius: 999px;
    padding: 0.3rem 0.62rem;
  }

  .service-media {
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--primary), white 66%);
    overflow: hidden;
    position: relative;
    min-height: 290px;
    background: color-mix(in srgb, var(--surface), white 14%);
  }

  .service-media input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .service-media img {
    width: 100%;
    height: 100%;
    min-height: 290px;
    object-fit: cover;
    display: none;
  }

  .service-media input:nth-of-type(1):checked ~ .media-shot-0,
  .service-media input:nth-of-type(2):checked ~ .media-shot-1,
  .service-media input:nth-of-type(3):checked ~ .media-shot-2 {
    display: block;
  }

  .media-tabs {
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    z-index: 2;
  }

  .media-tabs label {
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(18, 12, 10, 0.38);
    color: #fff6ef;
    padding: 0.2rem 0.42rem;
    font-size: 0.68rem;
  }

  .fallback {
    display: none;
    height: 100%;
  }

  @media (max-width: 860px) {
    .service-row {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .order {
      padding-top: 0;
    }

    .service-media {
      order: 3;
      max-width: 100%;
      min-height: 250px;
    }

    .service-media img {
      min-height: 250px;
    }
  }
</style>
