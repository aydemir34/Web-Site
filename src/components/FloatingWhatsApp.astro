---
import type { Business } from "../types";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import AnimatedIcon from "./AnimatedIcon.astro";

type Props = {
  business: Business;
};

const { business } = Astro.props;
const whatsappUrl = buildWhatsAppUrl(business);
---

<a class="floating-wa" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp'tan randevu bilgisi al">
  <AnimatedIcon name="message" size={24} />
</a>

<style>
  .floating-wa {
    position: fixed;
    right: 12px;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
    z-index: 55;
    text-decoration: none;
    display: inline-grid;
    place-items: center;
    background: #25d366;
    color: #fff;
    border-radius: 999px;
    width: 54px;
    height: 54px;
    box-shadow: 0 12px 24px -16px rgba(18, 99, 53, 0.55);
    border: 1px solid color-mix(in srgb, #25d366, black 8%);
  }

  @media (max-width: 640px) {
    .floating-wa {
      right: 10px;
      width: 52px;
      height: 52px;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 10px);
    }
  }
</style>
