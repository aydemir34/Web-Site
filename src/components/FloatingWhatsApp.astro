---
import type { Business } from "../types";
import { buildWhatsAppUrl } from "../lib/whatsapp";

type Props = {
  business: Business;
};

const { business } = Astro.props;
const whatsappUrl = buildWhatsAppUrl(business);
---

<a class="floating-wa" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp'tan randevu bilgisi al">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M19.1 4.9A9.83 9.83 0 0 0 12.02 2a9.99 9.99 0 0 0-8.7 14.9L2 22l5.3-1.3A9.95 9.95 0 0 0 12 22h.02a10 10 0 0 0 7.08-17.1Zm-7.08 15.4h-.02a8.3 8.3 0 0 1-4.23-1.15l-.3-.17-3.15.77.85-3.07-.2-.31a8.3 8.3 0 1 1 7.05 3.93Zm4.58-6.23c-.25-.12-1.48-.73-1.7-.82-.23-.08-.4-.12-.57.13-.17.25-.65.82-.8.98-.15.17-.3.19-.55.06-.25-.12-1.06-.39-2.03-1.25-.75-.67-1.26-1.5-1.4-1.76-.15-.25-.02-.39.1-.52.11-.11.25-.3.37-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.86-.2-.47-.4-.4-.56-.41h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.25.9 2.45 1.03 2.62.12.17 1.76 2.68 4.27 3.76.6.26 1.06.41 1.43.52.6.19 1.15.16 1.58.1.48-.07 1.48-.6 1.69-1.17.21-.58.21-1.08.15-1.17-.06-.1-.23-.15-.48-.27Z"
      fill="currentColor"
    />
  </svg>
</a>

<style>
  .floating-wa {
    position: fixed;
    right: 12px;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
    z-index: 55;
    text-decoration: none;
    display: inline-grid;
    place-items: center;
    background: #25d366;
    color: #fff;
    border-radius: 999px;
    width: 54px;
    height: 54px;
    box-shadow: 0 12px 24px -16px rgba(18, 99, 53, 0.55);
    border: 1px solid color-mix(in srgb, #25d366, black 8%);
  }

  .floating-wa svg {
    width: 23px;
    height: 23px;
  }

  @media (max-width: 640px) {
    .floating-wa {
      right: 10px;
      width: 52px;
      height: 52px;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 10px);
    }
  }
</style>
