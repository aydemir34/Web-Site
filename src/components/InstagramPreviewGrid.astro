---
import type { Business, Theme } from "../types";
import { getGridMedia } from "../lib/assets";

type Props = {
  business: Business;
  theme: Theme;
};

const { business, theme } = Astro.props;
void theme;
const images = getGridMedia(business);
---

<section class="section">
  <div class="container">
    <div class="head">
      <h2>Instagram Önizleme</h2>
      <a href={business.instagramUrl} target="_blank" rel="noreferrer">Profili Aç</a>
    </div>
    <div class="grid ig-grid">
      {
        images.slice(0, 6).map((item, index) => (
          <article class="card">
            {
              item ? (
                <>
                  <img
                    src={item}
                    alt={`${business.businessName} Instagram önizleme görseli ${index + 1}`}
                    loading="lazy"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                  />
                  <div class="grid-placeholder fallback" role="img" aria-label="Instagram görseli yer tutucu">
                    <span>Galeri önizleme</span>
                  </div>
                </>
              ) : (
                <div class="grid-placeholder" role="img" aria-label="Instagram görseli yer tutucu">
                  <span>Galeri önizleme</span>
                </div>
              )
            }
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 0.7rem;
  }

  .head a {
    text-decoration: none;
    color: var(--primary);
    font-weight: 700;
  }

  .ig-grid {
    margin-top: 0.95rem;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }

  .ig-grid article {
    overflow: hidden;
    border-radius: 14px;
    min-height: 140px;
  }

  .ig-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .grid-placeholder {
    width: 100%;
    height: 100%;
    min-height: 140px;
    display: grid;
    place-items: center;
    padding: 0.5rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--muted);
    background:
      radial-gradient(circle at 70% 10%, color-mix(in srgb, var(--accent), white 35%), transparent 40%),
      linear-gradient(130deg, color-mix(in srgb, var(--surface), white 30%), color-mix(in srgb, var(--bg-elevated), white 10%));
  }

  .grid-placeholder.fallback {
    display: none;
  }
</style>
