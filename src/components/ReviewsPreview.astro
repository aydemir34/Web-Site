---
import type { ReviewItem } from "../types";

type Props = {
  reviews: ReviewItem[];
};

const { reviews } = Astro.props;
---

<section class="section">
  <div class="container">
    <h2>Misafir Görüşleri</h2>
    <div class="grid reviews">
      {
        reviews.map((review) => (
          <blockquote class="card">
            <p>"{review.text}"</p>
            <footer>{review.name} - {review.service}</footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reviews {
    margin-top: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  blockquote {
    margin: 0;
    padding: 1rem;
    display: grid;
    gap: 0.7rem;
  }

  footer {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
