---
import type { Business } from "../types";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import AnimatedIcon from "./AnimatedIcon.astro";

type Props = {
  business: Business;
  ctaLabel?: string;
};

const { business, ctaLabel = "Randevu Bilgisi Al" } = Astro.props;
const whatsappUrl = buildWhatsAppUrl(business);
const formatLocalPhone = (phone: string) => {
  const digits = phone.replace(/\D/g, "");
  const local = digits.startsWith("90") ? `0${digits.slice(2)}` : digits;

  if (local.length !== 11) {
    return phone;
  }

  return `${local.slice(0, 4)} ${local.slice(4, 7)} ${local.slice(7, 9)} ${local.slice(9)}`;
};
const formattedPhone = formatLocalPhone(business.phone);
---

<div class="header-contact">
  <a class="phone-link" href={`tel:${business.phone}`} aria-label={`${formattedPhone} telefon ile ara`}>
    <AnimatedIcon name="phone" size={13} />
    {formattedPhone}
  </a>
  <a href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp üzerinden randevu bilgisi al">
    <svg class="whatsapp-glyph" viewBox="0 0 16 16" aria-hidden="true">
      <path
        d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"
        fill="currentColor"
      ></path>
    </svg>
    <span>{ctaLabel}</span>
  </a>
</div>

<style>
  .header-contact {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.32rem;
  }

  .header-contact a {
    text-decoration: none;
    border: 1px solid color-mix(in srgb, #25d366, black 15%);
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.34rem 0.62rem;
    background: color-mix(in srgb, #25d366, white 88%);
    color: #0f7d3c;
    display: inline-flex;
    align-items: center;
    gap: 0.36rem;
    line-height: 1;
    white-space: nowrap;
  }

  .header-contact a.phone-link {
    border-color: color-mix(in srgb, var(--primary), white 56%);
    background: color-mix(in srgb, var(--surface), white 18%);
    color: var(--text);
    padding-inline: 0.52rem;
  }

  .whatsapp-glyph {
    width: 13px;
    height: 13px;
    display: block;
    flex: 0 0 auto;
  }

  @media (max-width: 860px) {
    .header-contact a {
      font-size: 0.7rem;
      padding: 0.3rem 0.54rem;
    }
  }
</style>
