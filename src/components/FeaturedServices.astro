---
import type { Business, ServiceItem } from "../types";
import { getServiceMedia } from "../lib/assets";
import { slugify } from "../lib/slugify";
import EditorialVisualFallback from "./EditorialVisualFallback.astro";

type Props = {
  business: Business;
  services: ServiceItem[];
  maxItems?: number;
};

const { business, services, maxItems = 5 } = Astro.props;
const featured = services.slice(0, maxItems);
const servicesPath = `/demo/${business.slug}/hizmetler/`;
---

<section class="section featured-services">
  <div class="container">
    <div class="head">
      <div>
        <p class="eyebrow">Öne Çıkan Hizmetler</p>
        <h2>Özel gün hazırlıkları için hizmet seçkisi</h2>
      </div>
      <a class="all-link" href={servicesPath}>Tüm Hizmetleri Gör</a>
    </div>

    <div class="list">
      {
        featured.map((service, index) => {
          const media = getServiceMedia(business, service);
          return (
            <article id={`featured-${slugify(service.name)}`} class="item">
              <p class="order">{String(index + 1).padStart(2, "0")}</p>
              <div class="copy">
                <h3>{service.name}</h3>
                <p>{service.description}</p>
                <a class="mini-link" href={`${servicesPath}#${slugify(service.name)}`}>Detayı İncele</a>
              </div>
              <figure class="media">
                {
                  media ? (
                    <>
                      <img
                        src={media}
                        alt={`${service.name} için hizmet görseli`}
                        loading="lazy"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                      />
                      <div class="fallback">
                        <EditorialVisualFallback theme={business.themeId} aspectRatio="1/1" labels={["GELİN", "KINA", "DAVET"]} />
                      </div>
                    </>
                  ) : (
                    <EditorialVisualFallback theme={business.themeId} aspectRatio="1/1" labels={["GELİN", "KINA", "DAVET"]} />
                  )
                }
              </figure>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .featured-services {
    padding-top: 1rem;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 0.75rem;
  }

  .all-link {
    text-decoration: none;
    color: var(--primary);
    font-weight: 700;
    font-size: 0.86rem;
  }

  .list {
    margin-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--primary), white 66%);
  }

  .item {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) minmax(140px, 220px);
    gap: 0.7rem 1rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--primary), white 72%);
  }

  .order {
    font-size: 0.74rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    padding-top: 0.2rem;
  }

  .copy {
    display: grid;
    gap: 0.38rem;
  }

  .copy h3 {
    font-size: clamp(1rem, 2vw, 1.3rem);
  }

  .copy p {
    color: var(--muted);
  }

  .mini-link {
    justify-self: start;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary);
  }

  .media {
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--primary), white 66%);
    overflow: hidden;
  }

  .media img {
    width: 100%;
    height: 100%;
    min-height: 120px;
    object-fit: cover;
  }

  .fallback {
    display: none;
    height: 100%;
  }

  @media (max-width: 860px) {
    .head {
      align-items: start;
      flex-direction: column;
    }

    .item {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    .media {
      max-width: 400px;
    }
  }
</style>
