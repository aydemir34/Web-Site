---
import type { Business, ServiceItem } from "../types";
import { getFeaturedServiceMedia } from "../lib/assets";
import { slugify } from "../lib/slugify";
import EditorialVisualFallback from "./EditorialVisualFallback.astro";

type Props = {
  business: Business;
  services: ServiceItem[];
  maxItems?: number;
};

const { business, services, maxItems = 5 } = Astro.props;
const featured = services.slice(0, maxItems);
const servicesPath = `/demo/${business.slug}/hizmetler/`;
---

<section class="section featured-services">
  <div class="container">
    <div class="head">
      <div>
        <p class="eyebrow">Öne Çıkan Hizmetler</p>
        <h2>Özel gün hazırlıkları için hizmet seçkisi</h2>
      </div>
      <a class="all-link" href={servicesPath}>Tüm Hizmetleri Gör</a>
    </div>

    <div class="strip">
      {
        featured.map((service) => {
          const media = getFeaturedServiceMedia(business, service);
          return (
            <article id={`featured-${slugify(service.name)}`} class="item">
              <figure class="media">
                {
                  media ? (
                    <>
                      <img
                        src={media}
                        alt={`${service.name} için hizmet görseli`}
                        loading="lazy"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                      />
                      <div class="fallback">
                        <EditorialVisualFallback theme={business.themeId} aspectRatio="3/4" labels={["GELİN", "KINA", "DAVET"]} />
                      </div>
                    </>
                  ) : (
                    <EditorialVisualFallback theme={business.themeId} aspectRatio="3/4" labels={["GELİN", "KINA", "DAVET"]} />
                  )
                }
              </figure>
              <div class="overlay"></div>
              <div class="copy glass">
                <h3>{service.name}</h3>
                <p>{service.description}</p>
                <a class="mini-link" href={`${servicesPath}#${slugify(service.name)}`}>Detayı İncele</a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .featured-services {
    padding-top: 1rem;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 0.75rem;
  }

  .all-link {
    text-decoration: none;
    color: var(--primary);
    font-weight: 700;
    font-size: 0.86rem;
  }

  .strip {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .item {
    position: relative;
    min-height: 350px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--primary), white 64%);
    background: color-mix(in srgb, var(--surface), white 6%);
  }

  .copy {
    position: absolute;
    left: 0.58rem;
    right: 0.58rem;
    bottom: 0.58rem;
    display: grid;
    gap: 0.38rem;
    z-index: 2;
    padding: 0.55rem;
  }

  .copy h3 {
    font-size: clamp(0.95rem, 1.7vw, 1.12rem);
    color: #fff8f3;
  }

  .copy p {
    color: #f8eae0;
    font-size: 0.82rem;
  }

  .mini-link {
    justify-self: start;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff7ef;
  }

  .media {
    margin: 0;
    height: 100%;
  }

  .media img {
    width: 100%;
    height: 100%;
    min-height: 350px;
    object-fit: cover;
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(26, 16, 13, 0.02) 42%, rgba(26, 16, 13, 0.78) 100%),
      linear-gradient(160deg, rgba(26, 16, 13, 0.22), rgba(26, 16, 13, 0.05));
  }

  .glass {
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 250, 246, 0.13);
    backdrop-filter: blur(4px);
  }

  .fallback {
    display: none;
    height: 100%;
  }

  @media (max-width: 1120px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .head {
      align-items: start;
      flex-direction: column;
    }

    .strip {
      grid-template-columns: 1fr;
      gap: 0.62rem;
    }

    .item,
    .media img {
      min-height: 320px;
    }
  }
</style>
