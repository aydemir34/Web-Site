---
type Props = {
  steps: string[];
};

const { steps } = Astro.props;
---

<section class="section">
  <div class="container">
    <h2>Süreç Nasıl İşliyor</h2>
    <ol class="grid steps">
      {
        steps.map((step, index) => (
          <li class="card">
            <span>0{index + 1}</span>
            <p>{step}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    margin-top: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    list-style: none;
    padding: 0;
  }

  .steps li {
    padding: 1rem;
    display: grid;
    gap: 0.35rem;
  }

  .steps span {
    font-family: var(--font-heading);
    color: var(--primary);
    font-size: 1.35rem;
    font-weight: 700;
  }
</style>
