  .duo-panel img {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
  }

  .duo-panel::after {
    content: "";
    position: absolute;
    inset: 44% 0 0;
    background: linear-gradient(180deg, transparent, rgba(6, 18, 45, 0.76));
  }

  .duo-panel div {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: grid;
    gap: 0.25rem;
