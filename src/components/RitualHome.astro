  .review-stack p {
    color: #26324f;
    font-weight: 700;
  }

  .review-stack footer {
    margin-top: 0.5rem;
    color: #677698;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .final-cta-inner {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 0.86rem;
    border-radius: 14px;
    padding: clamp(1.4rem, 4vw, 2.5rem);
    background:
      radial-gradient(circle at 12% 8%, rgba(220, 150, 163, 0.2), transparent 18rem),
      linear-gradient(135deg, #ffffff, #f4f8ff);
    border: 1px solid rgba(20, 33, 63, 0.08);
