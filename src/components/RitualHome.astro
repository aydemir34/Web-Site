  .duo-panel p {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.98rem;
  }

  .duo-panel h3 {
    font-family: "Space Grotesk", var(--font-heading);
    font-size: clamp(1.14rem, 2vw, 1.72rem);
  }

  .process-band {
    margin: 0.5rem auto 1.25rem;
    width: min(1200px, calc(100% - 2rem));
    border-radius: 10px;
    background:
      radial-gradient(circle at 80% 20%, rgba(220, 150, 163, 0.24), transparent 22rem),
      linear-gradient(180deg, #fff7f9, #f8fcff);
    border: 1px solid rgba(220, 150, 163, 0.3);
    overflow: hidden;
  }

  .process-inner {
    padding: clamp(1.65rem, 3.4vw, 2.5rem) 0;
    text-align: left;
    display: grid;
    gap: 1rem;
  }

  .process-inner > div:first-child {
    display: grid;
    gap: 0.24rem;
    max-width: 620px;
  }

  .process-progress {
    width: 100%;
    height: 7px;
    background: rgba(20, 33, 63, 0.1);
    border-radius: 999px;
    margin-inline: 0;
    overflow: hidden;
  }

  .process-progress span {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(90deg, #14213f, #dc96a3);
    transition: width 420ms ease;
  }

  .process-inner ol {
    counter-reset: step;
    list-style: none;
    margin: 0;
    padding: 0;
