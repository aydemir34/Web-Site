    object-fit: cover;
    border-radius: 10px;
    background:
      radial-gradient(circle at 25% 15%, rgba(255, 255, 255, 0.72), transparent 12rem),
      linear-gradient(135deg, #edf3f8, #fbf6f8);
    border: 1px solid rgba(20, 33, 63, 0.08);
  }

  .reviews-band {
    background: #fff;
    overflow: hidden;
  }

  .reviews-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2.5vw, 1.45rem);
    align-items: stretch;
  }

  .reviews-copy {
    display: grid;
    justify-items: center;
    gap: 0.68rem;
    width: min(760px, 100%);
    margin-inline: auto;
    text-align: center;
  }

  .reviews-media-grid {
    --reviews-media-height: clamp(540px, 47vw, 720px);
    --review-card-height: clamp(172px, 15vw, 232px);
    --review-card-gap: clamp(0.52rem, 1vw, 0.74rem);
