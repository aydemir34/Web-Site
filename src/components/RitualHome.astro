  .video-panel {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    gap: 0.62rem;
    align-content: start;
    padding-top: 0;
  }

  .video-frame {
    height: var(--media-frame-height);
    min-height: 0;
    max-height: none;
    border-radius: 10px;
    overflow: hidden;
    background: #edf3f8;
  }

  .video-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-panel a {
    width: fit-content;
    position: static;
    border-radius: 999px;
    background: rgba(248, 252, 255, 0.94);
    color: #14213f;
    padding: 0.66rem 0.95rem;
    text-decoration: none;
    font-weight: 800;
    white-space: nowrap;
  }

  .gallery-mosaic {
    grid-column: span 2;
