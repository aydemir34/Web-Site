  .final-cta h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    max-width: 13ch;
  }

  .final-cta p {
    max-width: 54ch;
  }

  .cta-note {
    display: grid;
    gap: 0.24rem;
    width: min(680px, 100%);
    border-radius: 12px;
    border: 1px solid rgba(20, 33, 63, 0.1);
