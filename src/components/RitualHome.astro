  .process-inner li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    min-height: 160px;
    border-radius: 12px;
    border: 1px solid rgba(20, 33, 63, 0.08);
    background: rgba(255, 255, 255, 0.62);
    padding: 0.9rem;
    color: #14213f;
    font-weight: 800;
    opacity: 0.58;
    transform: translateY(14px);
    transition: opacity 360ms ease, transform 360ms ease, background 360ms ease, border-color 360ms ease;
