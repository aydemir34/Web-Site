---
import type { Business, Theme } from "../types";
import { getFeaturedServiceMedia, getGridMedia, getHeroMedia, getVideoMedia } from "../lib/assets";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import { slugify } from "../lib/slugify";
import EditorialVisualFallback from "./EditorialVisualFallback.astro";

type Props = {
  business: Business;
  theme: Theme;
};

const { business, theme } = Astro.props;
void theme;

const heroMedia = getHeroMedia(business);
const gridMedia = getGridMedia(business);
const videos = getVideoMedia(business);
const whatsAppUrl = buildWhatsAppUrl(business);
const googleReviewUrl = business.googleReviewUrl ?? business.mapUrl;
const servicesPath = `/demo/${business.slug}/hizmetler/`;
const contactPath = `/demo/${business.slug}/randevu/`;
const featuredServices = business.services.slice(0, 5);
const editorialImages = [
  gridMedia[1] ?? getFeaturedServiceMedia(business, business.services[0] ?? business.mainService),
  gridMedia[2] ?? getFeaturedServiceMedia(business, business.services[1] ?? business.mainService)
].filter(Boolean);
const extraGallery = gridMedia.slice(0, 8);
const servicePresentation: Record<string, { summary: string; label: string }> = {
  "gelin-saci-ve-makyaji": {
    summary: "Düğün sabahı için saç, makyaj ve prova akışı birlikte planlanır.",
    label: "Gelin"
  },
  "kina-hazirligi": {
    summary: "Kına gecesi temposuna uygun saç ve makyaj dili birlikte seçilir.",
    label: "Kına"
  },
  "nisan-hazirligi": {
    summary: "Nişan ve söz hazırlığında zarif, fotoğrafa dengeli bir görünüm hazırlanır.",
    label: "Nişan"
  },
  "davet-makyaji": {
    summary: "Davet, mezuniyet ve kutlamalar için taze duran makyaj planlanır.",
    label: "Davet"
  },
  "ozel-gun-sac-tasarimi": {
    summary: "Topuz, dalga veya toplu stiller etkinlik akışına göre şekillenir.",
    label: "Saç Tasarımı"
  }
};
const proofItems = [
  {
    label: `${business.district} / ${business.neighborhood}`,
    icon: "",
    href: business.mapUrl,
    ariaLabel: `${business.district} ${business.neighborhood} konumu için Google Maps`
  },
  {
    label: `${business.leadSignals.rating.toLocaleString("tr-TR")} Google Puanı`,
    icon: "★",
    href: googleReviewUrl,
    ariaLabel: `${business.businessName} Google puanını görüntüle`
  },
  {
    label: `${business.leadSignals.reviewCount}+ Yorum`,
    icon: "",
    href: googleReviewUrl,
    ariaLabel: `${business.businessName} Google yorumlarını görüntüle`
  },
  { label: "Gelin Prova Planı", icon: "" },
  { label: "Düğün Günü Ekip Desteği", icon: "" }
] satisfies Array<{ label: string; icon: string; href?: string; ariaLabel?: string }>;
const processDetails = [
  {
    title: "Tarih ve konsept konuşması",
    text: "Gününüz, mekanınız, kıyafetiniz ve istediğiniz görünüm netleşir."
  },
  {
    title: "Prova günü planı",
    text: "Saç, makyaj ve aksesuar seçenekleri birlikte denenir."
  },
  {
    title: "Son rötuşlar",
    text: "Cilt tonu, ışık, fotoğraf ve kalıcılık detayları kontrol edilir."
  },
  {
    title: "Özel gün uygulaması",
    text: "Saat planına göre hazırlık süreci sakin şekilde ilerler."
  }
];
const ctaHints = [
  { title: "Tarih", text: "Müsaitlik için gün ve saat aralığı" },
  { title: "Etkinlik türü", text: "Gelin, kına, nişan veya davet" },
  { title: "Kişi sayısı", text: "Sadece siz ya da ek hazırlıklar" },
  { title: "İstenen görünüm", text: "Doğal, belirgin, topuz veya dalga" }
];
const firstVideo = videos[0] ?? null;
const reviewImage = gridMedia[4] ?? gridMedia[3] ?? gridMedia[0] ?? heroMedia;
const reviewScreens = ["/assets/library/all/review-1.png", "/assets/library/all/review-2.png", "/assets/library/all/review-3.png"];
const beforeAfter = {
  beforeMobile: "/assets/library/all/bride-before.jpeg",
  afterMobile: "/assets/library/all/bride-after.jpeg",
  beforeDesktop: "/assets/library/all/bride-before-web.jpeg",
  afterDesktop: "/assets/library/all/bride-after-web.jpeg"
};
---

<div class="ritual-home">
  <section class="ritual-hero" data-reveal data-reveal-delay="0">
    <div class="hero-media" aria-hidden={heroMedia ? "true" : "false"}>
      {
        heroMedia ? (
          <img src={heroMedia} alt={`${business.businessName} özel gün saç ve makyaj görseli`} loading="eager" onerror="this.style.display='none'" />
        ) : (
          <EditorialVisualFallback theme={business.themeId} aspectRatio="16/9" labels={["Gelin", "Kına", "Davet"]} />
        )
      }
    </div>
    <div class="hero-wash"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        {business.hero.eyebrow && <p class="hero-eyebrow" data-reveal data-reveal-delay="120">{business.hero.eyebrow}</p>}
        <h1 data-reveal data-reveal-delay="2000">
          <span class="hero-title-desktop">TELAŞSIZ SABAH<br />KUSURSUZ GÜN</span>
        </h1>
        <div class="hero-actions" data-reveal data-reveal-delay="2260">
          <a class="btn btn-primary" href={whatsAppUrl} target="_blank" rel="noreferrer">{business.hero.primaryCta}</a>
          <a class="btn btn-secondary" href={servicesPath}>{business.hero.secondaryCta}</a>
        </div>
      </div>
      <div class="hero-mini-gallery" aria-label="Seçili hazırlık görselleri" data-reveal data-reveal-delay="2520">
        {extraGallery.slice(0, 3).map((item, index) => <img src={item} alt={`Hazırlık görseli ${index + 1}`} loading={index === 0 ? "eager" : "lazy"} style={`--mini:${index};`} onerror="this.style.display='none'" />)}
      </div>
    </div>
  </section>

  <section class="proof-strip" aria-label="Sosyal kanıt" data-reveal data-reveal-delay="0">
    <div class="container proof-scroller" data-proof-scroller>
      <div class="proof-track">
        <div class="proof-segment">
          {
            proofItems.map((item) =>
              item.href ? (
                <a
                  class="proof-pill"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={item.ariaLabel}
                >
                  {item.icon ? <span class="proof-icon">{item.icon}</span> : null}
                  {item.label}
                </a>
              ) : (
                <span class="proof-pill">
                  {item.icon ? <span class="proof-icon">{item.icon}</span> : null}
                  {item.label}
                </span>
              )
            )
          }
        </div>
        <div class="proof-segment proof-segment-clone" aria-hidden="true">
          {
            proofItems.map((item) =>
              item.href ? (
                <a
                  class="proof-pill"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex="-1"
                >
                  {item.icon ? <span class="proof-icon">{item.icon}</span> : null}
                  {item.label}
                </a>
              ) : (
                <span class="proof-pill">
                  {item.icon ? <span class="proof-icon">{item.icon}</span> : null}
                  {item.label}
                </span>
              )
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section service-shelf" id="hizmet-vitrini" data-reveal>
    <div class="container">
      <div class="section-head shelf-head">
        <div>
          <h2>Özel gün hazırlıkları</h2>
          <p>Gelin, kına, nişan ve davet için en çok sorulan saç ve makyaj seçenekleri.</p>
        </div>
        <a class="shelf-cta" href={servicesPath}>Tüm Hizmetleri İnceleyin</a>
      </div>
      <div class="shelf" aria-label="Öne çıkan hizmetler">
        {
          featuredServices.map((service, index) => {
            const media = getFeaturedServiceMedia(business, service);
            const meta = servicePresentation[slugify(service.name)] ?? { summary: service.description, label: "Özel Gün" };
            return (
              <article class="service-tile" style={`--stagger:${index};`}>
                <a href={`${servicesPath}#${slugify(service.name)}`}>
                  <figure>
                    {
                      media ? (
                        <img src={media} alt={`${service.name} hizmet görseli`} loading="lazy" onerror="this.style.display='none'" />
                      ) : (
                        <EditorialVisualFallback theme={business.themeId} aspectRatio="3/4" labels={["SAÇ", "MAKYAJ"]} />
                      )
                    }
                  </figure>
                  <div class="service-tile-copy">
                    <span class="service-tag">{meta.label}</span>
                    <h3>{service.name}</h3>
                    <p>{meta.summary}</p>
                    <strong>Detayı İnceleyin</strong>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section transformation-compare" data-reveal>
    <div class="container compare-inner">
      <div class="compare-copy">
        <p>Hazırlık Öncesi / Hazırlık Sonrası</p>
        <h2>Hazırlık öncesinden özel gün görünümüne</h2>
        <span>Amaç yüz hatlarını değiştirmek değil; saç, makyaj ve ışık dengesini özel gün konseptine uyumlu hale getirmek.</span>
      </div>
      <div class="compare-frame" data-before-after style="--compare-position: 50%;">
        <picture>
          <source media="(min-width: 641px)" srcset={beforeAfter.beforeDesktop} />
          <img src={beforeAfter.beforeMobile} alt="Hazırlık öncesi temsili gelin görseli" loading="lazy" />
        </picture>
        <picture class="compare-after">
          <source media="(min-width: 641px)" srcset={beforeAfter.afterDesktop} />
          <img src={beforeAfter.afterMobile} alt="Gelin dokunuşu sonrası temsili özel gün görünümü" loading="lazy" />
        </picture>
        <span class="compare-label compare-label-before">Hazırlık Öncesi</span>
        <span class="compare-label compare-label-after">Gelin Dokunuşu</span>
        <span class="compare-handle" aria-hidden="true"></span>
        <input type="range" min="8" max="92" value="50" aria-label="Hazırlık öncesi ve gelin dokunuşu karşılaştırması" data-before-after-control />
      </div>
      <p class="compare-note">Görseller temsilidir. Yayın öncesi işletmenin kendi çalışmalarıyla değiştirilebilir.</p>
    </div>
  </section>

  <section class="section editorial-duo" data-reveal>
    <div class="container">
      <div class="duo-title">
        <h2>Hazırlık sabahı daha sakin aksın</h2>
      </div>
      <div class="duo-grid">
        {
          editorialImages.slice(0, 2).map((item, index) => (
            <article class="duo-panel" style={`--panel:${index};`}>
              <img src={item!} alt={index === 0 ? "Gelin hazırlık süreci" : "Özel gün saç ve makyaj detayı"} loading="lazy" onerror="this.style.display='none'" />
              <div>
                <p>{index === 0 ? "Prova Günü" : "Görünüm Seçimi"}</p>
                <h3>{index === 0 ? "Saç, makyaj ve aksesuar fikri önceden birlikte denenir." : "Kıyafet, mekan ışığı ve fotoğraf planı aynı dilde buluşur."}</h3>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="process-band" id="hazirlik-sureci" data-reveal>
    <div class="container process-inner">
      <div>
        <h2>Hazırlık Süreci</h2>
        <p>İlk mesajdan özel gün sabahına kadar akış adım adım görünür ilerler.</p>
      </div>
      <div class="process-progress" aria-hidden="true">
        <span data-process-progress></span>
      </div>
      <ol>
        {
          processDetails.map((step, index) => (
            <li data-process-step style={`--step:${index};`}>
              <small>{String(index + 1).padStart(2, "0")}</small>
              <strong>{step.title}</strong>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section media-story" id="galeri" data-reveal>
    <div class="container media-story-grid">
      <article class="video-panel">
        <div class="video-frame">
          {
            firstVideo ? (
              <video src={firstVideo} autoplay muted loop playsinline preload="metadata" aria-label="Hazırlık süreci videosu"></video>
            ) : (
              <EditorialVisualFallback theme={business.themeId} aspectRatio="3/4" labels={["VİDEO", "HAZIRLIK"]} />
            )
          }
        </div>
        <a href={business.instagramUrl} target="_blank" rel="noreferrer">Instagram Karelerini İnceleyin</a>
      </article>
      <div class="gallery-mosaic">
        <div class="section-head">
          <h2>Hazırlıktan seçili kareler</h2>
          <p>Stil kararını verirken saç formu, makyaj yoğunluğu ve aksesuar dengesi birlikte değerlendirilir.</p>
        </div>
        <div class="mosaic-grid">
          {extraGallery.slice(0, 2).map((item, index) => <img src={item} alt={`Galeri görseli ${index + 1}`} loading="lazy" onerror="this.style.display='none'" />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section reviews-band" id="yorumlar" data-reveal>
    <div class="container reviews-inner">
      <div class="reviews-copy">
        <p class="stars">★★★★★ <span>({business.leadSignals.reviewCount}+ yorum)</span></p>
        <h2>Misafir yorumlarında öne çıkan konu: rahat hazırlık akışı</h2>
        <p>Randevu saatinden prova detayına kadar sürecin net olması, özel gün sabahında daha sakin hissettiriyor.</p>
        <a
          href={googleReviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${business.businessName} Google yorumlarını gör`}
        >
          Google yorumlarını gör
        </a>
      </div>
      <div class="reviews-media-grid">
        <div class="review-docs" aria-label="Google yorum ekran görüntüleri">
          {reviewScreens.map((item, index) => (
            <figure class="review-card">
              <img src={item} alt={`Google yorum ekran görüntüsü ${index + 1}`} loading="lazy" onerror="this.style.display='none'" />
            </figure>
          ))}
        </div>
        <div class="review-stack" aria-label="Misafir yorumları">
          <figure class="review-photo">
            {
              reviewImage ? (
                <img src={reviewImage} alt="Yorumlar için hazırlık görseli" loading="lazy" onerror="this.style.display='none'" />
              ) : (
                <EditorialVisualFallback theme={business.themeId} aspectRatio="3/4" labels={["YORUMLAR"]} />
              )
            }
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section final-cta" data-reveal>
    <div class="container final-cta-inner">
      <h2>{business.cta.title}</h2>
      <p>{business.cta.description}</p>
      <div class="cta-note">
        <strong>WhatsApp mesajınızda şunları yazmanız yeterli:</strong>
        <span>Tarih, etkinlik türü, kişi sayısı, hazırlık lokasyonu ve istediğiniz görünüm.</span>
      </div>
      <div class="cta-hints" aria-label="Randevu mesajı için bilgiler">
        {ctaHints.map((item) => <article><strong>{item.title}</strong><span>{item.text}</span></article>)}
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href={whatsAppUrl} target="_blank" rel="noreferrer">{business.cta.buttonText}</a>
        <a class="btn btn-secondary" href={contactPath}>Randevu & İletişim</a>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  const root = document.documentElement;
  root.classList.add("ritual-enhanced");
  const expressive = new URLSearchParams(window.location.search).get("motion") === "expressive";
  if (expressive) {
    root.classList.add("motion-expressive");
  }

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const revealItems = document.querySelectorAll("[data-reveal]");
  const ritualRoot = document.querySelector(".ritual-home");

  if (ritualRoot && !prefersReducedMotion) {
    ritualRoot.classList.add("motion-enabled");
  }

  document.querySelectorAll("[data-before-after]").forEach((slider) => {
    const control = slider.querySelector("[data-before-after-control]");
    if (!(slider instanceof HTMLElement) || !(control instanceof HTMLInputElement)) {
      return;
    }

    const syncCompare = () => {
      slider.style.setProperty("--compare-position", `${control.value}%`);
    };

    control.addEventListener("input", syncCompare);
    syncCompare();
  });

  if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }
          const delay = Number(entry.target.getAttribute("data-reveal-delay") ?? "0");
          window.setTimeout(() => entry.target.classList.add("is-visible"), delay);
          revealObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.18 }
    );

    revealItems.forEach((item) => {
      const revealImmediately = item.closest(".ritual-hero") || item.classList.contains("proof-strip");
      if (revealImmediately) {
        const delay = Number(item.getAttribute("data-reveal-delay") ?? "0");
        window.setTimeout(() => item.classList.add("is-visible"), delay);
      } else {
        revealObserver.observe(item);
      }
    });

    const steps = Array.from(document.querySelectorAll("[data-process-step]"));
    const progress = document.querySelector("[data-process-progress]");
    const processBand = document.querySelector(".process-band");
    const desktopAutoplay = !prefersReducedMotion && window.matchMedia("(min-width: 981px)").matches;

    if (steps.length > 0 && desktopAutoplay && processBand) {
      const runProcessSequence = () => {
        steps.forEach((step) => step.classList.remove("is-active"));
        if (progress) {
          progress.style.width = "0%";
        }
        steps.forEach((_, index) => {
          window.setTimeout(() => {
            steps.forEach((item, stepIndex) => item.classList.toggle("is-active", stepIndex <= index));
            if (progress) {
              const percent = ((index + 1) / steps.length) * 100;
              progress.style.width = `${percent}%`;
            }
          }, index * 360);
        });
      };

      const processObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }
            runProcessSequence();
            processObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.35 }
      );

      processObserver.observe(processBand);
    } else if (steps.length > 0) {
      const stepObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }
            const index = steps.indexOf(entry.target);
            steps.forEach((step, stepIndex) => step.classList.toggle("is-active", stepIndex <= index));
            if (progress) {
              const percent = ((index + 1) / steps.length) * 100;
              progress.style.width = `${percent}%`;
            }
          });
        },
        { rootMargin: "-35% 0px -45% 0px", threshold: 0.2 }
      );

      steps.forEach((step) => stepObserver.observe(step));
    }
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }
</script>

<style>
  .ritual-home {
    --ritual-ink: #f5f7fc;
    --ritual-primary: #14213f;
    --ritual-muted: #cad4ea;
    --ritual-rose: #dc96a3;
    --ritual-bg: #070d1f;
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 100%;
    background:
      radial-gradient(circle at 80% 8%, rgba(220, 150, 163, 0.24), transparent 34rem),
      radial-gradient(circle at 10% 12%, rgba(20, 33, 63, 0.46), transparent 20rem),
      linear-gradient(180deg, #090f20 0%, #111a2f 18%, #f7f9ff 28%, #fff 100%);
    color: #101829;
    overflow-x: clip;
  }

  .ritual-home::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.14;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 20px 20px;
    mask-image: linear-gradient(180deg, black, transparent 56%);
  }

  .ritual-hero {
    position: relative;
    min-height: min(840px, 94svh);
    overflow: hidden;
    display: grid;
    align-items: stretch;
    border-bottom: 1px solid rgba(184, 198, 229, 0.26);
  }

  .hero-media,
  .hero-wash {
    position: absolute;
    inset: 0;
  }

  .hero-media img,
  .hero-media :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transform-origin: center center;
    filter: saturate(0.95) contrast(1.06);
  }

  .hero-wash {
    opacity: 0;
    background:
      radial-gradient(circle at 18% 24%, rgba(220, 150, 163, 0.24), transparent 24rem),
      linear-gradient(90deg, rgba(9, 14, 32, 0.92) 0%, rgba(9, 14, 32, 0.62) 34%, rgba(9, 14, 32, 0.18) 76%),
      linear-gradient(180deg, rgba(8, 12, 28, 0.64), rgba(8, 12, 28, 0.22));
    transition: opacity 680ms ease 1800ms;
  }

  .ritual-hero.is-visible .hero-wash {
    opacity: 1;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding: clamp(4.3rem, 7vw, 5.8rem) 0 clamp(1rem, 2.5vw, 1.35rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.62fr);
    align-items: center;
    gap: clamp(0.9rem, 2.8vw, 2rem);
  }

  .hero-inner,
  .hero-copy,
  .hero-mini-gallery,
  .proof-inner,
  .shelf,
  .duo-grid,
  .process-inner,
  .media-story-grid,
  .reviews-inner,
  .reviews-media-grid,
  .final-cta-inner {
    min-width: 0;
  }

  .hero-copy {
    max-width: 600px;
    display: grid;
    gap: 0.78rem;
    color: var(--ritual-ink);
  }

  .hero-eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--ritual-rose), white 22%);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    font-weight: 800;
  }

  .hero-copy h1 {
    font-family: "Space Grotesk", var(--font-heading);
    font-size: clamp(2.25rem, 5.9vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: 0;
    color: #f8fbff;
    max-width: 10.5ch;
    text-wrap: balance;
  }

  .hero-copy p {
