    border-color: transparent;
    box-shadow: 0 20px 36px -24px rgba(11, 22, 52, 0.8);
  }

  .ritual-home .btn-secondary {
    background: rgba(11, 20, 44, 0.28);
    border-color: rgba(233, 240, 255, 0.56);
    color: #f5f8ff;
  }

  .hero-mini-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(70px, 1fr));
    gap: 0.55rem;
    justify-self: end;
    align-self: center;
    width: min(390px, 100%);
  }

  .hero-mini-gallery img {
    aspect-ratio: 4 / 5;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.32);
    box-shadow: 0 24px 40px -30px rgba(1, 6, 20, 0.94);
    opacity: 0;
    transform: translateY(18px) scale(0.96);
    transition: opacity 520ms ease, transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--mini, 0) * 130ms);
  }

  .hero-mini-gallery.is-visible img {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .proof-strip {
    background: rgba(11, 20, 44, 0.88);
    border-block: 1px solid rgba(220, 150, 163, 0.4);
  }

  .proof-scroller {
    min-height: 56px;
    display: flex;
    align-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .proof-scroller::-webkit-scrollbar {
    display: none;
  }

  .proof-track {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.52rem;
    min-width: max-content;
    padding-block: 0.2rem;
    padding-inline: 0.14rem;
  }

  .proof-segment {
    display: inline-flex;
    align-items: center;
    gap: 0.52rem;
    padding-right: 0.52rem;
  }

  .proof-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    min-height: 32px;
    border-radius: 999px;
    padding: 0.34rem 0.62rem;
    color: rgba(238, 243, 255, 0.92);
    font-size: 0.76rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .proof-strip a.proof-pill {
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
  }

  .proof-icon {
    color: #ffc83d;
    font-size: 0.86rem;
  }

  .service-shelf {
    position: relative;
    z-index: 1;
    background:
      radial-gradient(circle at 88% 0%, rgba(220, 150, 163, 0.18), transparent 22rem),
      linear-gradient(180deg, #f8fbff 0%, #fff 100%);
    border-bottom: 1px solid rgba(20, 33, 63, 0.08);
    color: #14213f;
    padding-block: clamp(1.8rem, 4vw, 3.2rem);
  }

  .transformation-compare {
    background:
      radial-gradient(circle at 10% 0%, rgba(220, 150, 163, 0.16), transparent 18rem),
      linear-gradient(180deg, #fff 0%, #f8fbff 100%);
    border-bottom: 1px solid rgba(20, 33, 63, 0.08);
    padding-block: clamp(2rem, 4.8vw, 3.7rem);
  }

  .compare-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(340px, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
    min-width: 0;
  }

  .compare-copy {
    display: grid;
    gap: 0.58rem;
    max-width: 520px;
  }

  .compare-copy p {
    margin: 0;
    color: #8d5c70;
    font-weight: 900;
    font-size: 0.76rem;
  }

  .compare-copy h2 {
    font-family: "Space Grotesk", var(--font-heading);
    color: #14213f;
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 0.96;
    max-width: 12ch;
  }

  .compare-copy span,
  .compare-note {
    color: #4c5871;
    line-height: 1.55;
  }

  .compare-frame {
    --compare-position: 50%;
    position: relative;
    isolation: isolate;
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: 360px;
    overflow: hidden;
    border-radius: 14px;
    background: #edf3f8;
    border: 1px solid rgba(20, 33, 63, 0.1);
    box-shadow: 0 28px 56px -42px rgba(20, 33, 63, 0.58);
  }

  .compare-frame picture,
  .compare-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .compare-frame img {
    object-fit: cover;
  }

  .compare-after {
    clip-path: inset(0 0 0 var(--compare-position));
  }

  .compare-label {
    position: absolute;
    z-index: 3;
    top: 0.8rem;
    border-radius: 999px;
    padding: 0.42rem 0.68rem;
    background: rgba(248, 251, 255, 0.86);
    color: #14213f;
    font-size: 0.76rem;
    font-weight: 900;
    box-shadow: 0 14px 28px -24px rgba(20, 33, 63, 0.64);
    backdrop-filter: blur(12px);
  }

  .compare-label-before {
    left: 0.8rem;
  }

  .compare-label-after {
    right: 0.8rem;
  }

  .compare-handle {
    position: absolute;
    z-index: 4;
    top: 0;
    bottom: 0;
    left: var(--compare-position);
    width: 2px;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 0 0 1px rgba(20, 33, 63, 0.16);
    pointer-events: none;
  }

  .compare-handle::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 42px;
    height: 42px;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    background:
      linear-gradient(90deg, transparent 42%, #14213f 42% 48%, transparent 48% 52%, #14213f 52% 58%, transparent 58%),
      rgba(248, 251, 255, 0.94);
    border: 1px solid rgba(20, 33, 63, 0.18);
    box-shadow: 0 16px 28px -20px rgba(20, 33, 63, 0.72);
  }

  .compare-frame input {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .compare-note {
    grid-column: 2;
    margin: -0.45rem 0 0;
    font-size: 0.78rem;
  }

  .editorial-duo {
    padding-top: clamp(1.7rem, 3.8vw, 3rem);
  }

  .media-story,
  .reviews-band,
  .final-cta {
    padding-block: clamp(2.1rem, 4.6vw, 3.8rem);
  }

  .section-head {
    display: grid;
    gap: 0.34rem;
    max-width: 620px;
  }

  .shelf-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.8rem;
    max-width: none;
  }

  .shelf-head > div {
    display: grid;
    gap: 0.34rem;
    max-width: 620px;
  }

  .section-head h2,
  .duo-title h2,
  .process-inner h2,
  .reviews-copy h2,
  .final-cta h2 {
    font-family: "Space Grotesk", var(--font-heading);
    color: #14213f;
  }

  .section-head p,
  .process-inner p,
  .reviews-copy p,
  .final-cta p {
    color: #4c5871;
  }

  .shelf {
    margin-top: 0.92rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.82rem;
    overflow: visible;
    padding: 0.2rem 0 0.86rem;
  }

  .service-tile {
    --tile-tint: rgba(220, 150, 163, 0.12);
    --tile-border: rgba(220, 150, 163, 0.26);
    scroll-snap-align: start;
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 460ms ease, transform 460ms ease;
    transition-delay: calc(var(--stagger, 0) * 70ms);
  }

  .service-shelf.is-visible .service-tile {
    opacity: 1;
    transform: translateY(0);
  }

  .service-tile:nth-child(2) {
    --tile-tint: rgba(177, 210, 246, 0.18);
    --tile-border: rgba(116, 154, 211, 0.28);
  }

  .service-tile:nth-child(3) {
    --tile-tint: rgba(244, 217, 188, 0.2);
    --tile-border: rgba(214, 166, 116, 0.25);
  }

  .service-tile:nth-child(4) {
    --tile-tint: rgba(206, 237, 226, 0.18);
    --tile-border: rgba(121, 175, 152, 0.24);
  }

  .service-tile:nth-child(5) {
    --tile-tint: rgba(218, 209, 247, 0.17);
    --tile-border: rgba(146, 131, 194, 0.25);
  }

  .service-tile a {
    display: grid;
    gap: 0;
    text-decoration: none;
    color: inherit;
    min-height: 100%;
    border: 1px solid var(--tile-border);
    border-radius: 12px;
    overflow: hidden;
    background:
      linear-gradient(148deg, var(--tile-tint), rgba(255, 255, 255, 0.72)),
      rgba(255, 255, 255, 0.72);
    box-shadow: 0 22px 48px -38px rgba(20, 33, 63, 0.54);
    backdrop-filter: blur(16px);
    transition: transform 240ms ease, box-shadow 240ms ease;
  }

  .service-tile:hover a {
    transform: translateY(-1px);
    box-shadow: 0 26px 52px -38px rgba(20, 33, 63, 0.58);
  }

  .service-tile figure {
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: 0;
    background: #eef3f8;
    overflow: hidden;
  }

  .service-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .service-tile:hover img {
    transform: scale(1.03);
  }

  .service-tile-copy {
    display: grid;
    gap: 0.38rem;
    align-content: start;
    min-height: 170px;
    padding: 0.78rem;
  }

  .service-tag {
    width: fit-content;
    border-radius: 999px;
    background: rgba(220, 150, 163, 0.16);
    color: #7b4153;
    padding: 0.2rem 0.48rem;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.03em;
  }

  .service-tile h3 {
    font-family: "Space Grotesk", var(--font-heading);
    font-size: clamp(1.03rem, 1.3vw, 1.22rem);
    line-height: 1.05;
    color: #14213f;
  }

  .service-tile p {
    color: #59647c;
    font-size: 0.78rem;
    line-height: 1.42;
  }

  .service-tile strong,
  .shelf-cta,
  .reviews-copy a {
    color: #14213f;
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .service-tile strong {
    margin-top: auto;
  }

  .shelf-cta {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(20, 33, 63, 0.24);
    background: #fff;
    padding: 0.65rem 0.95rem;
    white-space: nowrap;
    box-shadow: 0 14px 28px -24px rgba(20, 33, 63, 0.62);
  }

  .duo-title {
    display: grid;
    place-items: center;
    text-align: center;
    margin-bottom: 0.72rem;
  }

  .duo-title h2 {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    max-width: 14.5ch;
  }

  .duo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .duo-panel {
    position: relative;
    overflow: hidden;
    height: clamp(420px, 44vw, 600px);
    min-height: 420px;
    max-height: 620px;
    border-radius: 10px;
