---
import type { Business, BusinessTone, ServiceItem, Theme } from "../types";
import { getServiceMedia } from "../lib/assets";
import { buildWhatsAppUrl } from "../lib/whatsapp";

type Props = {
  services: ServiceItem[];
  tone?: BusinessTone;
  business?: Business;
  theme?: Theme;
};

const { services, tone, business, theme } = Astro.props;
const isEditorial = tone === "bridal-editorial";
void theme;
---

<section class="section">
  <div class="container">
    <h2>Öne Çıkan Hizmet Akışı</h2>
    <div class="carousel" role="region" aria-label="Hizmet kaydırma alanı">
      {
        services.map((service) => {
          const serviceImage = business ? getServiceMedia(business, service) : null;
          return (
            <article class={`item ${isEditorial ? "editorial" : ""}`}>
            {
              isEditorial && (
                <div class="media-wrap">
                  {
                    serviceImage ? (
                      <>
                        <img
                          src={serviceImage}
                          alt={`${service.name} için hizmet görseli`}
                          loading="lazy"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                        />
                        <div class="media-fallback">Editorial hizmet görünümü</div>
                      </>
                    ) : (
                      <div class="media-fallback media-fallback-live">Editorial hizmet görünümü</div>
                    )
                  }
                </div>
              )
            }
            <h3>{service.name}</h3>
            <p>{service.description}</p>
            {
              business && (
                <a class="service-cta" href={buildWhatsAppUrl(business, service)} target="_blank" rel="noreferrer">
                  Randevu ve Fiyat Sor
                </a>
              )
            }
          </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .carousel {
    margin-top: 0.95rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 1fr);
    gap: 1rem;
    overflow-x: auto;
    padding: 0.2rem 0 0.35rem;
    scroll-snap-type: x proximity;
  }

  .item {
    padding: 1.15rem 1.05rem;
    scroll-snap-align: start;
    min-height: 185px;
    border-left: 1px solid color-mix(in srgb, var(--primary), white 68%);
    border-top: 1px solid color-mix(in srgb, var(--primary), white 68%);
    border-radius: 0 16px 0 16px;
    background: color-mix(in srgb, var(--surface), white 22%);
  }

  .item h3 {
    margin-bottom: 0.45rem;
    font-size: 1.05rem;
  }

  .service-cta {
    margin-top: 0.55rem;
    justify-self: start;
    text-decoration: none;
    font-size: 0.74rem;
    border: 1px solid color-mix(in srgb, #25d366, black 16%);
    color: #157347;
    background: color-mix(in srgb, #25d366, white 90%);
    border-radius: 999px;
    padding: 0.24rem 0.52rem;
  }

  .media-wrap {
    margin: -0.2rem -0.1rem 0.75rem;
    border-radius: 10px;
    min-height: 148px;
    overflow: hidden;
    position: relative;
    border: 1px solid color-mix(in srgb, var(--primary), white 64%);
    background: linear-gradient(145deg, color-mix(in srgb, var(--surface), white 28%), color-mix(in srgb, var(--bg-elevated), white 12%));
  }

  .media-wrap img {
    width: 100%;
    height: 100%;
    min-height: 148px;
    object-fit: cover;
  }

  .media-fallback {
    display: none;
    min-height: 148px;
    place-items: center;
    font-size: 0.8rem;
    color: var(--muted);
    background:
      radial-gradient(120px 90px at 85% 12%, color-mix(in srgb, var(--accent), white 40%), transparent 52%),
      linear-gradient(140deg, color-mix(in srgb, var(--surface), white 32%), color-mix(in srgb, var(--bg-elevated), white 15%));
  }

  .media-fallback-live {
    display: grid;
  }

  .item.editorial {
    border-left-color: color-mix(in srgb, var(--primary), white 48%);
    border-top-color: color-mix(in srgb, var(--primary), white 48%);
    background:
      radial-gradient(circle at 90% 10%, color-mix(in srgb, var(--accent), white 50%), transparent 40%),
      color-mix(in srgb, var(--surface), white 12%);
    box-shadow: 0 16px 34px -30px var(--glow);
  }
</style>
