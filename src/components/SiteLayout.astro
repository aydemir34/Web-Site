---
import "../styles/global.css";
import type { Business, Theme } from "../types";
import type { SeoMeta } from "../lib/seo";
import HeaderContact from "./HeaderContact.astro";
import FloatingWhatsApp from "./FloatingWhatsApp.astro";
import BackgroundOrnaments from "./BackgroundOrnaments.astro";
import FooterMega from "./FooterMega.astro";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import { getBusinessLogo } from "../lib/assets";

type Props = {
  business: Business;
  theme: Theme;
  seo: SeoMeta;
  currentPath: string;
  schema: Record<string, unknown>;
  variant?: string;
};

const { business, theme, seo, currentPath, schema, variant = "default" } = Astro.props;
const basePath = `/demo/${business.slug}/`;
const navItems = [
  { label: "Ana Sayfa", href: basePath },
  { label: "Hizmetler", href: `${basePath}hizmetler/` },
  { label: "Randevu & İletişim", href: `${basePath}randevu/` }
];
const whatsApp = buildWhatsAppUrl(business);
const logo = getBusinessLogo(business);
const compactDesktopCta = business.themeId === "clean-clinic-minimal" ? "Randevu Al" : "Randevu Bilgisi Al";
const mobileBrandFallback = business.businessName.split(" ").slice(0, 2).join(" ");
const formatLocalPhone = (phone: string) => {
  const digits = phone.replace(/\D/g, "");
  const local = digits.startsWith("90") ? `0${digits.slice(2)}` : digits;
  return local.length === 11 ? `${local.slice(0, 4)} ${local.slice(4, 7)} ${local.slice(7, 9)} ${local.slice(9)}` : phone;
};
const formattedPhone = formatLocalPhone(business.phone);
const faviconInitials = business.businessName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part.charAt(0).toLocaleUpperCase("tr-TR"))
  .join("");
const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="${theme.palette.primary}"/><text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" font-weight="700" fill="${theme.palette.primaryContrast}">${faviconInitials}</text></svg>`;
const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body
    data-variant={variant}
    data-archetype={business.archetype ?? ""}
    data-tone={business.tone}
    style={`--bg:${theme.palette.bg};--bg-elevated:${theme.palette.bgElevated};--surface:${theme.palette.surface};--text:${theme.palette.text};--muted:${theme.palette.muted};--primary:${theme.palette.primary};--primary-contrast:${theme.palette.primaryContrast};--accent:${theme.palette.accent};--border:${theme.palette.border};--glow:${theme.palette.glow};--font-heading:${theme.fontHeading};--font-body:${theme.fontBody};`}
  >
    <BackgroundOrnaments styleId={business.visualProfile?.ornamentStyle ?? theme.ornamentStyle} />

    <header class="site-header">
      <div class="container desktop-bar">
        <a class="brand" href={basePath}>
          {
            logo ? (
              <>
                <img src={logo} alt={`${business.businessName} logosu`} class="brand-logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />
                <span class="brand-text fallback">{business.businessName}</span>
              </>
            ) : (
              <span class="brand-text">{business.businessName}</span>
            )
          }
        </a>
        <nav aria-label="Site bölümleri">
          <ul>
            {
              navItems.map((item) => (
                <li><a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a></li>
              ))
            }
          </ul>
        </nav>
        <div class="desktop-contact">
          <HeaderContact business={business} ctaLabel={compactDesktopCta} />
        </div>
      </div>

      <div class="container mobile-bar">
        <a class="brand mobile-brand" href={basePath}>
          {
            logo ? (
              <>
                <img src={logo} alt={`${business.businessName} logosu`} class="brand-logo mobile-logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />
                <span class="brand-text fallback">{mobileBrandFallback}</span>
              </>
            ) : (
              <span class="brand-text">{mobileBrandFallback}</span>
            )
          }
        </a>
        <div class="mobile-actions">
          <a class="phone-mini" href={`tel:${business.phone}`} aria-label={`${formattedPhone} telefon ile ara`}>
            {formattedPhone}
          </a>
          <details class="menu" data-mobile-menu>
            <summary class="menu-trigger" aria-label="Menüyü aç" aria-controls="mobile-menu-panel" aria-expanded="false">
              <span class="hamburger-icon" aria-hidden="true">
                <span class="hamburger-line line-1"></span>
                <span class="hamburger-line line-2"></span>
                <span class="hamburger-line line-3"></span>
              </span>
            </summary>
            <button class="menu-overlay" type="button" aria-label="Menüyü kapat" data-menu-close></button>
            <nav id="mobile-menu-panel" aria-label="Mobil menü">
              <ul>
                {
                  navItems.map((item) => (
                    <li><a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a></li>
                  ))
                }
                <li><a class="menu-phone" href={`tel:${business.phone}`}>{formattedPhone}</a></li>
                <li><a class="menu-instagram" href={business.instagramUrl} target="_blank" rel="noreferrer">Instagram</a></li>
                <li><a class="menu-wa" href={whatsApp} target="_blank" rel="noreferrer">WhatsApp'tan Randevu Bilgisi Al</a></li>
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <script is:inline>
      if (new URLSearchParams(window.location.search).get("motion") === "expressive") {
        document.documentElement.classList.add("motion-expressive");
      }

      const menu = document.querySelector("[data-mobile-menu]");
      if (menu instanceof HTMLDetailsElement) {
        const closeTriggers = menu.querySelectorAll("a, [data-menu-close]");
        const menuTrigger = menu.querySelector(".menu-trigger");
        const closeMenu = () => {
          if (!menu.open) {
            return;
          }
          menu.open = false;
          syncMenuState();
        };
        const setMenuTriggerState = () => {
          if (!(menuTrigger instanceof HTMLElement)) {
            return;
          }
          menuTrigger.setAttribute("aria-expanded", menu.open ? "true" : "false");
          menuTrigger.setAttribute("aria-label", menu.open ? "Menüyü kapat" : "Menüyü aç");
        };

        const syncMenuState = () => {
          document.documentElement.classList.toggle("menu-open", menu.open);
          document.body.classList.toggle("menu-open", menu.open);
          setMenuTriggerState();
        };

        menu.addEventListener("toggle", syncMenuState);

        closeTriggers.forEach((item) => {
          item.addEventListener("click", () => {
            closeMenu();
          });
        });

        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closeMenu();
          }
        });

        window.addEventListener("wheel", closeMenu, { passive: true });
        window.addEventListener("touchmove", closeMenu, { passive: true });

        window.addEventListener("resize", () => {
          if (window.innerWidth > 920 && menu.open) {
            menu.open = false;
            syncMenuState();
          }
        });

        setMenuTriggerState();
      }

      const header = document.querySelector(".site-header");
      if (header instanceof HTMLElement) {
        const topThreshold = 8;
        let ticking = false;

        const onScroll = () => {
          const currentScrollY = Math.max(0, window.scrollY);
          header.classList.toggle("is-scrolled", currentScrollY > topThreshold);
          ticking = false;
        };

        const requestScrollUpdate = () => {
          if (!ticking) {
            window.requestAnimationFrame(onScroll);
            ticking = true;
          }
        };

        onScroll();
        window.addEventListener("scroll", requestScrollUpdate, { passive: true });
        window.addEventListener(
          "pagehide",
          () => {
            window.removeEventListener("scroll", requestScrollUpdate);
          },
          { once: true }
        );
      }
    </script>

    <main class="fade-up">
      <slot />
    </main>

    <FooterMega business={business} basePath={basePath} />
    <FloatingWhatsApp business={business} />
  </body>
</html>

<style>
	  .site-header {
	    position: fixed;
	    top: 0;
      left: 0;
      right: 0;
	    z-index: 80;
	    max-width: 100%;
	    overflow: visible;
	    backdrop-filter: blur(12px);
	    border-bottom: 1px solid color-mix(in srgb, var(--primary), white 78%);
	    background:
	      linear-gradient(90deg, color-mix(in srgb, var(--bg), white 34%), color-mix(in srgb, var(--surface), white 22%));
	    transition: box-shadow 220ms ease, border-color 220ms ease, transform 260ms ease;
	  }

	  .site-header.is-scrolled {
	    box-shadow: 0 14px 28px -24px rgba(11, 19, 39, 0.62);
	    border-bottom-color: color-mix(in srgb, var(--primary), white 70%);
	  }

    :global(body) {
      padding-top: 82px;
    }

  .brand {
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-logo {
    height: 67px;
    width: auto;
    max-width: 360px;
    object-fit: contain;
  }

	  .brand-logo.mobile-logo {
	    height: 44px;
	    max-width: 230px;
	  }

  .brand-text.fallback {
    display: none;
  }

  .desktop-bar {
    min-height: 82px;
    display: grid;
    grid-template-columns: minmax(240px, 1fr) minmax(160px, auto) minmax(240px, 1fr);
    align-items: center;
    gap: 0.75rem;
  }

  .desktop-bar > .brand {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
  }

  .desktop-bar > nav {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }

  .desktop-contact {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
  }

  .desktop-bar nav ul {
    list-style: none;
    display: flex;
    gap: 0.62rem;
    margin: 0;
    padding: 0;
  }

  .desktop-bar nav a {
    text-decoration: none;
    font-size: 0.78rem;
    line-height: 1;
    color: var(--muted);
    font-weight: 800;
  }

  .desktop-bar nav a[aria-current="page"] {
    color: var(--text);
    font-weight: 700;
  }

  .mobile-bar {
    display: none;
    width: min(100%, calc(100vw - 1.2rem));
    min-width: 0;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 0.3rem;
  }

  .mobile-brand {
    font-size: 0.9rem;
    line-height: 1;
    max-width: calc(100% - 170px);
  }

  .mobile-actions {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.35rem;
  }

  .phone-mini {
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--primary), white 62%);
    background: color-mix(in srgb, var(--surface), white 18%);
    border-radius: 999px;
    text-decoration: none;
    padding: 0.34rem 0.52rem;
    font-size: 0.7rem;
    line-height: 1;
    font-weight: 800;
    white-space: nowrap;
  }

  .menu summary {
    list-style: none;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--primary), white 64%);
    border-radius: 999px;
    cursor: pointer;
    background: color-mix(in srgb, var(--surface), white 18%);
    transition:
      transform 220ms ease,
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
    box-shadow: 0 10px 26px -22px var(--glow);
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary:hover {
    border-color: color-mix(in srgb, var(--primary), white 52%);
    background: color-mix(in srgb, var(--surface), white 24%);
    box-shadow: 0 14px 26px -20px var(--glow);
  }

  .menu summary:active {
    transform: scale(0.96);
  }

  .menu summary:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--primary), white 46%);
    outline-offset: 2px;
  }

  .hamburger-icon {
    width: 16px;
    height: 14px;
    display: grid;
    align-content: center;
    gap: 3px;
  }

  .hamburger-line {
    height: 1.7px;
    width: 100%;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text), black 12%);
    transition: transform 240ms ease, opacity 220ms ease, width 220ms ease;
    transform-origin: center;
  }

  .menu[open] .hamburger-line.line-1 {
    transform: translateY(4.7px) rotate(45deg);
  }

  .menu[open] .hamburger-line.line-2 {
    opacity: 0;
    width: 0;
  }

  .menu[open] .hamburger-line.line-3 {
    transform: translateY(-4.7px) rotate(-45deg);
  }

  .menu nav {
    position: fixed;
    left: 0.6rem;
    right: 0.6rem;
    top: 64px;
    width: auto;
    max-height: calc(100dvh - 64px - env(safe-area-inset-bottom) - 0.8rem);
    border: 1px solid color-mix(in srgb, var(--primary), white 72%);
    border-radius: 0 0 16px 16px;
    background: color-mix(in srgb, var(--surface), white 10%);
    box-shadow: 0 18px 36px -28px var(--glow);
    padding: 0.38rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    z-index: 130;
  }

  .menu-overlay {
    position: fixed;
    inset: 64px 0 0;
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    background: rgba(6, 12, 24, 0.42);
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms ease;
    z-index: 120;
  }

  .menu[open] .menu-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .menu nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .menu nav a {
    display: block;
    padding: 0.72rem 0.78rem;
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.2;
    border-radius: 10px;
  }

  .menu nav a[aria-current="page"] {
    color: var(--primary);
    font-weight: 700;
    background: color-mix(in srgb, var(--accent), white 64%);
  }

  .menu nav a.menu-phone,
  .menu nav a.menu-instagram,
  .menu nav a.menu-wa {
    margin-top: 0.15rem;
  }

  .menu nav a.menu-wa {
    color: #157347;
    font-weight: 700;
    background: color-mix(in srgb, #25d366, white 88%);
  }

  @media (max-width: 920px) {
    :global(body) {
      padding-top: 65px;
    }

    .desktop-bar {
      display: none;
    }

    .mobile-bar {
      display: flex;
    }

    .mobile-brand {
      max-width: calc(100% - 190px);
    }

    .brand-logo.mobile-logo {
      height: 54px;
      max-width: 236px;
    }
  }

	  :global(html.menu-open),
	  :global(body.menu-open) {
	    overflow: hidden;
      touch-action: none;
	  }

	  @media (prefers-reduced-motion: reduce) {
	    .site-header {
	      transition: box-shadow 220ms ease, border-color 220ms ease;
	    }
	  }
	</style>
