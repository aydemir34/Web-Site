---
import type { Business } from "../types";
import { getGridMedia, getServiceMediaGallery, getVideoMedia } from "../lib/assets";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import { slugify } from "../lib/slugify";
import FAQAccordion from "./FAQAccordion.astro";

type Props = {
  business: Business;
};

const { business } = Astro.props;
const basePath = `/demo/${business.slug}/`;
const firstService = business.services[0];
const heroMedia = "/assets/library/all/makeup-eyebrow-2.jpg";
const galleryMedia = getGridMedia(business);
const videoMedia = getVideoMedia(business);
const processDetails = [
  ["Tarih ve konsept konuşması", "Gününüz, mekanınız, kıyafetiniz ve istediğiniz görünüm netleşir."],
  ["Prova günü planı", "Saç, makyaj ve aksesuar seçenekleri birlikte denenir."],
  ["Son rötuşlar", "Cilt tonu, ışık, fotoğraf ve kalıcılık detayları kontrol edilir."],
  ["Özel gün uygulaması", "Saat planına göre hazırlık süreci sakin şekilde ilerler."]
];
const ctaHints = [
  { title: "Tarih", text: "Müsaitlik için gün ve saat aralığı" },
  { title: "Etkinlik türü", text: "Gelin, kına, nişan veya davet" },
  { title: "Kişi sayısı", text: "Sadece siz ya da ek hazırlıklar" },
  { title: "İstenen görünüm", text: "Doğal, belirgin, topuz veya dalga" }
];
const allMediaFallbacks = [
  "/assets/library/all/hair-washing-3.mp4",
  "/assets/library/all/makeup-2.mp4",
  "/assets/library/all/makeup-eye-1.webm",
  "/assets/library/all/makeup-eyeliner-1.mp4",
  "/assets/library/all/makeup-nail.webm",
  "/assets/library/all/hair-1.webm",
  "/assets/library/all/3996969-uhd_2160_4096_25fps.mp4",
  "/assets/library/all/7585489-uhd_2160_4096_25fps.mp4",
  "/assets/library/all/4772529-uhd_2160_3840_24fps.mp4",
  "/assets/library/all/makeup-eye-2.mp4",
  "/assets/library/all/hair-3.mp4",
  "/assets/library/all/makeup-bride-1.jpg",
  "/assets/library/all/hair-decoration-bride.jpg",
  "/assets/library/all/makeup-eye-1.jpg"
];
const usableVideoMedia = videoMedia.filter((item) => !item.includes(`/assets/businesses/${business.slug}/`));
const reelMedia = Array.from(new Set([...allMediaFallbacks, ...usableVideoMedia, ...galleryMedia])).slice(0, 14);
const topReel = reelMedia.slice(0, 8);
const bottomReel = [...reelMedia.slice(5), ...reelMedia.slice(0, 5)].slice(0, 8);
const isVideoMedia = (src: string) => /\.(mp4|webm)$/i.test(src);
---

<section class="services-hero" data-reveal data-reveal-delay="0">
  {
    heroMedia && (
      <div class="services-hero-media" aria-hidden="true">
        <img src={heroMedia} alt="" loading="eager" onerror="this.style.display='none'" />
      </div>
    )
  }
  <div class="services-hero-wash"></div>
  <div class="container services-hero-inner">
    <div data-reveal data-reveal-delay="80">
      <p class="services-eyebrow">Hazırlık Seçimi</p>
      <h1>Hangi güne hazırlanıyoruz?</h1>
      <p>Gelin, kına, nişan ya da davet... Saç ve makyaj akışını günün temposuna göre birlikte seçelim.</p>
    </div>
    <a class="btn btn-primary" href={buildWhatsAppUrl(business)} target="_blank" rel="noreferrer" data-reveal data-reveal-delay="180">WhatsApp’tan Randevu Bilgisi Alın</a>
  </div>
</section>

<section class="section service-dossier" data-service-dossier data-reveal>
  <div class="container dossier-grid">
    <aside class="service-index" aria-label="Hizmet seçimi">
      <p>Hazırlık Seçimi</p>
      <h2>Güne göre ilerleyin</h2>
      <div class="service-tabs" role="tablist" aria-label="Hizmetler">
        {
          business.services.map((service, index) => (
            <button
              id={`tab-${slugify(service.name)}`}
              type="button"
              role="tab"
              class:list={["service-tab", index === 0 && "is-active"]}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={slugify(service.name)}
              data-service-tab={slugify(service.name)}
              data-effect={index % 5}
            >
              <span>{String(index + 1).padStart(2, "0")}</span>
              {service.name}
            </button>
          ))
        }
      </div>
    </aside>

    <div class="service-panels">
      {
        business.services.map((service, index) => {
          const id = slugify(service.name);
          const media = getServiceMediaGallery(business, service, 4);
          const waUrl = buildWhatsAppUrl(business, service);
          const orderedMedia = [media[0] ?? null, media[1] ?? null, media[2] ?? null, media[3] ?? null].filter(
            (item): item is string => Boolean(item)
          );
          const mediaCount = Math.min(orderedMedia.length, 3);
          const mediaMain = orderedMedia[0] ?? null;
          const mediaA = orderedMedia[1] ?? null;
          const mediaB = orderedMedia[2] ?? null;
          return (
            <article
              id={id}
              class:list={["service-panel", index === 0 && "is-active"]}
              data-service-panel={id}
              role="tabpanel"
              aria-labelledby={`tab-${id}`}
              data-effect={index % 5}
            >
              <div class="panel-copy">
                <p class="service-number">{String(index + 1).padStart(2, "0")}</p>
                <h3>{service.name}</h3>
                <p>{service.detailBody ?? service.description}</p>
                {service.bestFor && <p class="best-for"><strong>Kimler için:</strong> {service.bestFor}</p>}
                <ul>
                  {(service.detailPoints ?? business.processSteps).slice(0, 4).map((point) => <li>{point}</li>)}
                </ul>
                <div class="panel-actions">
                  <a class="btn btn-primary" href={waUrl} target="_blank" rel="noreferrer">Bu Hizmet İçin Bilgi Alın</a>
                  <a class="btn btn-secondary" href={`${basePath}randevu/`}>Randevu & İletişim</a>
                </div>
              </div>
              {mediaCount > 0 && (
                <div class:list={["panel-media", `count-${mediaCount}`]} data-panel-media>
                  {mediaMain && (
                    <figure class="media-shot media-main">
                      <img
                        src={mediaMain}
                        alt={`${service.name} görseli 1`}
                        loading="lazy"
                        onerror="this.closest('figure')?.setAttribute('hidden','true')"
                      />
                    </figure>
                  )}
                  {mediaA && (
                    <figure class="media-shot media-a">
                      <img
                        src={mediaA}
                        alt={`${service.name} görseli 2`}
                        loading="lazy"
                        onerror="this.closest('figure')?.setAttribute('hidden','true')"
                      />
                    </figure>
                  )}
                  {mediaB && (
                    <figure class="media-shot media-b">
                      <img
                        src={mediaB}
                        alt={`${service.name} görseli 3`}
                        loading="lazy"
                        onerror="this.closest('figure')?.setAttribute('hidden','true')"
                      />
                    </figure>
                  )}
                </div>
              )}
            </article>
          );
        })
      }
    </div>

    <div class="service-accordion" aria-label="Hizmet detayları">
      {
        business.services.map((service, index) => {
          const id = slugify(service.name);
          const media = getServiceMediaGallery(business, service, 4);
          const waUrl = buildWhatsAppUrl(business, service);
          const compactMedia = [media[0] ?? null, media[1] ?? null, media[2] ?? null].filter((item): item is string => Boolean(item)).slice(0, 2);
          return (
            <article class:list={["accordion-service", index === 0 && "is-open"]} data-accordion-service>
              <button
                id={`accordion-tab-${id}`}
                class="accordion-trigger"
                type="button"
                aria-expanded={index === 0 ? "true" : "false"}
                aria-controls={`accordion-panel-${id}`}
                data-accordion-trigger
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{service.name}</strong>
                <i aria-hidden="true"></i>
              </button>
              <div
                id={`accordion-panel-${id}`}
                class="accordion-panel"
                role="region"
                aria-labelledby={`accordion-tab-${id}`}
                hidden={index === 0 ? undefined : true}
                data-accordion-panel
              >
                <div class="panel-copy">
                  <h3>{service.name}</h3>
                  <p>{service.detailBody ?? service.description}</p>
                  {service.bestFor && <p class="best-for"><strong>Kimler için:</strong> {service.bestFor}</p>}
                  <ul>
                    {(service.detailPoints ?? business.processSteps).slice(0, 4).map((point) => <li>{point}</li>)}
                  </ul>
                  <div class="mobile-media-pair">
                    {compactMedia.map((item, mediaIndex) => (
                      <figure class="media-shot">
                        <img
                          src={item}
                          alt={`${service.name} mobil görseli ${mediaIndex + 1}`}
                          loading="lazy"
                          onerror="this.closest('figure')?.setAttribute('hidden','true')"
                        />
                      </figure>
                    ))}
                  </div>
                  <div class="panel-actions">
                    <a class="btn btn-primary" href={waUrl} target="_blank" rel="noreferrer">Bu Hizmet İçin Bilgi Alın</a>
                    <a class="btn btn-secondary" href={`${basePath}randevu/`}>Randevu & İletişim</a>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<section class="section service-flow" data-reveal data-flow-steps>
  <div class="container flow-inner">
    <div>
      <h2>Prova Günü Akışı</h2>
      <p>İlk görüşmeden özel gün uygulamasına kadar süreç sade, anlaşılır ve randevu odaklı ilerler.</p>
    </div>
    <ol>
      {
        processDetails.map(([title, text], index) => (
          <li data-flow-step style={`--step:${index};`}>
            <strong>{title}</strong>
            <span>{text}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="section service-reels" data-reveal aria-label="Hazırlık videosu seçkisi">
  <div class="reel-copy container">
    <p>Hazırlık Ritmi</p>
    <h2>Saç, makyaj ve son dokunuşlar aynı akışta.</h2>
  </div>
  <div class="reel-lanes" aria-hidden="true">
    <div class="reel-track reel-track-top">
      {[...topReel, ...topReel].map((item) => (
        <figure class="reel-card">
          {
            isVideoMedia(item) ? (
              <video src={item} autoplay muted loop playsinline preload="metadata"></video>
            ) : (
              <img src={item} alt="" loading="lazy" onerror="this.closest('figure')?.setAttribute('hidden','true')" />
            )
          }
        </figure>
      ))}
    </div>
    <div class="reel-track reel-track-bottom">
      {[...bottomReel, ...bottomReel].map((item) => (
        <figure class="reel-card">
          {
            isVideoMedia(item) ? (
              <video src={item} autoplay muted loop playsinline preload="metadata"></video>
            ) : (
              <img src={item} alt="" loading="lazy" onerror="this.closest('figure')?.setAttribute('hidden','true')" />
            )
          }
        </figure>
      ))}
    </div>
  </div>
</section>

<FAQAccordion items={business.faq} />

<section class="section services-cta" data-reveal>
  <div class="container services-cta-inner">
    <h2>{firstService ? `${firstService.name} için tarih sor` : business.cta.title}</h2>
    <p>{business.cta.description}</p>
    <div class="cta-hints" aria-label="Randevu mesajı için bilgiler">
      {ctaHints.map((item) => <article><strong>{item.title}</strong><span>{item.text}</span></article>)}
    </div>
    <a class="btn btn-primary" href={buildWhatsAppUrl(business, firstService ?? business.mainService)} target="_blank" rel="noreferrer">
      WhatsApp’tan Bilgi Alın
    </a>
  </div>
</section>

<script is:inline>
  const root = document.documentElement;
  root.classList.add("ritual-enhanced");
  const expressive = new URLSearchParams(window.location.search).get("motion") === "expressive";
  if (expressive) {
    root.classList.add("motion-expressive");
  }
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const reveals = document.querySelectorAll("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }
          const delay = Number(entry.target.getAttribute("data-reveal-delay") ?? "0");
          window.setTimeout(() => entry.target.classList.add("is-visible"), delay);
          revealObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.18 }
    );
    reveals.forEach((item) => revealObserver.observe(item));
  } else {
    reveals.forEach((item) => item.classList.add("is-visible"));
  }

  document.querySelectorAll("[data-service-dossier]").forEach((dossier) => {
    const tabs = Array.from(dossier.querySelectorAll("[data-service-tab]"));
    const panels = Array.from(dossier.querySelectorAll("[data-service-panel]"));
    const normalizePanelMedia = (panel) => {
      const media = panel.querySelector("[data-panel-media]");
      if (!(media instanceof HTMLElement)) {
        return;
      }
      const visibleShots = Array.from(media.querySelectorAll(".media-shot")).filter((item) => !item.hasAttribute("hidden")).length;
      media.classList.remove("count-3", "count-2", "count-1");
      if (visibleShots <= 0) {
        media.remove();
        return;
      }
      media.classList.add(`count-${Math.min(3, visibleShots)}`);
    };
    panels.forEach((panel) => {
      panel.querySelectorAll("img").forEach((img) => {
        img.addEventListener("error", () => normalizePanelMedia(panel));
      });
      normalizePanelMedia(panel);
    });

    const activate = (tab) => {
      const target = tab.getAttribute("data-service-tab");
      const effect = Number(tab.getAttribute("data-effect") ?? "0");
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", active ? "true" : "false");
      });

      panels.forEach((panel) => {
        const isActive = panel.getAttribute("data-service-panel") === target;
        panel.classList.toggle("is-active", isActive);
        if (!isActive) {
          return;
        }
        normalizePanelMedia(panel);
        if (!prefersReducedMotion) {
          const copy = panel.querySelector(".panel-copy");
          const media = panel.querySelector("[data-panel-media]");
          const starts = [
            { opacity: 0, transform: "translateX(-92px)" },
            { opacity: 0, transform: "translateY(42px)", filter: "blur(14px)" },
            { opacity: 0, transform: "scale(0.72)" },
            { opacity: 0, transform: "translateY(72px)" },
            { opacity: 0, clipPath: "inset(0 100% 0 0)", transform: "translateX(48px)" }
          ];
          const mediaStarts = [
            { opacity: 0, transform: "translateX(92px) scale(0.96)" },
            { opacity: 0, transform: "scale(0.84)", filter: "blur(18px)" },
            { opacity: 0, transform: "scale(1.12)" },
            { opacity: 0, transform: "translateY(-58px)" },
            { opacity: 0, clipPath: "inset(0 0 100% 0)", transform: "translateY(36px)" }
          ];
          const end = { opacity: 1, transform: "translateX(0) translateY(0) scale(1)", filter: "blur(0)", clipPath: "inset(0 0 0 0)" };
          const timing = {
            duration: expressive ? 760 : 560,
            easing: expressive ? "cubic-bezier(0.18,0.72,0.18,1)" : "cubic-bezier(0.2,0.72,0.2,1)"
          };
          if (copy instanceof HTMLElement) {
            copy.animate([starts[effect] ?? starts[0], end], timing);
          }
          if (media instanceof HTMLElement) {
            media.animate([mediaStarts[effect] ?? mediaStarts[0], end], { ...timing, delay: 80 });
          }
        }
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"].includes(event.key)) {
          return;
        }
        event.preventDefault();
        const nextIndex =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? tabs.length - 1
              : event.key === "ArrowRight" || event.key === "ArrowDown"
                ? (index + 1) % tabs.length
                : (index - 1 + tabs.length) % tabs.length;
        const nextTab = tabs[nextIndex];
        if (nextTab) {
          nextTab.focus();
          activate(nextTab);
        }
      });
    });

  });

  document.querySelectorAll("[data-accordion-service]").forEach((item) => {
    const trigger = item.querySelector("[data-accordion-trigger]");
    const panel = item.querySelector("[data-accordion-panel]");
    if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) {
      return;
    }

    trigger.addEventListener("click", () => {
      document.querySelectorAll("[data-accordion-service]").forEach((service) => {
        const serviceTrigger = service.querySelector("[data-accordion-trigger]");
        const servicePanel = service.querySelector("[data-accordion-panel]");
        const active = service === item;
        service.classList.toggle("is-open", active);
        if (serviceTrigger instanceof HTMLButtonElement) {
          serviceTrigger.setAttribute("aria-expanded", active ? "true" : "false");
        }
        if (servicePanel instanceof HTMLElement) {
          servicePanel.hidden = !active;
        }
      });

      if (!prefersReducedMotion) {
        panel.animate(
          [
            { opacity: 0, transform: "translateY(10px)" },
            { opacity: 1, transform: "translateY(0)" }
          ],
          { duration: 280, easing: "ease" }
        );
      }
    });
  });

  document.querySelectorAll("[data-flow-steps]").forEach((flow) => {
    const steps = Array.from(flow.querySelectorAll("[data-flow-step]"));
    if (steps.length === 0) {
      return;
    }
    const showSteps = () => {
      steps.forEach((step, index) => {
        window.setTimeout(() => step.classList.add("is-visible"), prefersReducedMotion ? 0 : index * 180);
      });
    };
    if ("IntersectionObserver" in window) {
      const flowObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }
            showSteps();
            flowObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.32 }
      );
      flowObserver.observe(flow);
    } else {
      showSteps();
    }
  });

  if (!prefersReducedMotion) {
    const heroImage = document.querySelector(".services-hero-media img");
    let ticking = false;

    const updateHero = () => {
      const amount = Math.min(window.scrollY * 0.045, 36);
      if (heroImage) {
        heroImage.style.setProperty("--services-hero-shift", `${amount}px`);
      }
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHero);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>

<style>
  .services-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 12%, rgba(220, 150, 163, 0.2), transparent 24rem),
      linear-gradient(180deg, #080e1f, #0f1730);
    border-bottom: 1px solid rgba(220, 150, 163, 0.32);
  }

  .services-hero-media,
  .services-hero-wash {
    position: absolute;
    inset: 0;
  }

  .services-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateY(var(--services-hero-shift, 0)) scale(1.08);
    transition: transform 180ms linear;
    filter: saturate(0.94) contrast(1.08);
  }

  .services-hero-wash {
    background:
      radial-gradient(circle at 22% 18%, rgba(220, 150, 163, 0.22), transparent 18rem),
      linear-gradient(92deg, rgba(8, 13, 30, 0.95) 0%, rgba(8, 13, 30, 0.68) 44%, rgba(8, 13, 30, 0.2) 100%),
      linear-gradient(180deg, rgba(8, 13, 30, 0.56), rgba(8, 13, 30, 0.24));
  }

  .services-hero-inner {
    position: relative;
    z-index: 1;
    min-height: min(580px, 70svh);
    padding: clamp(4.7rem, 8vw, 6.2rem) 0 clamp(1.25rem, 3vw, 1.8rem);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 0.9rem;
  }

  .services-eyebrow {
    margin: 0;
    color: rgba(220, 150, 163, 0.9);
    font-weight: 900;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
  }

  .services-hero h1,
  .service-index h2,
  .service-panel h3,
  .accordion-panel h3,
  .flow-inner h2,
  .reel-copy h2,
  .services-cta h2 {
    font-family: "Space Grotesk", var(--font-heading);
    color: #14213f;
  }

  .services-hero h1 {
    font-size: clamp(2.4rem, 6.8vw, 5rem);
    max-width: 10ch;
    line-height: 0.92;
    color: #f6f9ff;
    text-wrap: balance;
  }

  .services-hero p {
    color: rgba(235, 240, 252, 0.92);
    max-width: 54ch;
    margin-top: 0.68rem;
  }

  .services-hero .btn {
    border-radius: 999px;
    min-height: 44px;
    padding: 0.72rem 1rem;
    background: #f6f9ff;
    color: #0d1a36;
    border-color: transparent;
  }

  .service-dossier {
    background:
      radial-gradient(circle at 8% 28%, rgba(20, 33, 63, 0.06), transparent 22rem),
      #fbfcff;
  }

  .dossier-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(0.95rem, 2.8vw, 1.8rem);
    align-items: stretch;
    min-width: 0;
  }

  .service-index {
    position: relative;
    display: grid;
    gap: 0;
    min-width: 0;
    grid-column: span 4;
    align-self: stretch;
    max-width: none;
    min-height: clamp(500px, 36vw, 560px);
  }

  .service-index > p {
    display: none;
  }

  .service-index h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .service-tabs {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 0;
    min-width: 0;
    width: 100%;
    height: 100%;
    border-block: 1px solid rgba(20, 33, 63, 0.28);
  }

  .service-tab {
    appearance: none;
    border: 0;
    border-bottom: 1px solid rgba(20, 33, 63, 0.24);
    background: transparent;
    color: #14213f;
    min-height: 0;
    border-radius: 0;
    text-align: left;
    padding: clamp(0.76rem, 1.7vw, 1.1rem) 0.9rem;
    font: 900 clamp(0.9rem, 1.5vw, 1.16rem)/1.05 "Space Grotesk", var(--font-heading);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
