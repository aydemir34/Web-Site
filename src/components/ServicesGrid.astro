---
import type { Business, BusinessTone, ServiceItem } from "../types";
import { getServiceMedia } from "../lib/assets";
import { slugify } from "../lib/slugify";
import { buildWhatsAppUrl } from "../lib/whatsapp";

type Props = {
  services: ServiceItem[];
  title?: string;
  tone?: BusinessTone;
  business?: Business;
};

const { services, title = "Öne Çıkan Hizmetler", tone, business } = Astro.props;
const isEditorial = tone === "bridal-editorial";
---

<section class="section">
  <div class="container">
    <h2 class="section-title">{title}</h2>
    <p class="section-note">Düğün ve özel gün hazırlıkları için planlanan premium hizmet akışı.</p>
    <div class="grid services">
      {
        services.map((service, index) => (
          <article id={slugify(service.name)} class={`service-card ${isEditorial ? "editorial" : ""}`}>
            {business && <a class="service-cta" href={buildWhatsAppUrl(business, service)} target="_blank" rel="noreferrer">Randevu ve Fiyat Sorun</a>}
            {
              business && (
                <figure class="service-media">
                  {
                    getServiceMedia(business, service) ? (
                      <>
                        <img
                          src={getServiceMedia(business, service) ?? ""}
                          alt={`${service.name} görseli`}
                          loading="lazy"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                        />
                        <div class="media-fallback fallback" role="img" aria-label="Hizmet görseli yer tutucu"></div>
                      </>
                    ) : (
                      <div class="media-fallback" role="img" aria-label="Hizmet görseli yer tutucu"></div>
                    )
                  }
                </figure>
              )
            }
            <p class="eyebrow">Hizmet {index + 1}</p>
            <h3>{service.name}</h3>
            <p>{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    margin-top: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem 1rem;
  }

  .section-title {
    margin-bottom: 0.35rem;
  }

  .section-note {
    color: var(--muted);
    max-width: 62ch;
  }

  .service-card {
    padding: 1.2rem 1.05rem;
    display: grid;
    gap: 0.48rem;
    border-left: 1px solid color-mix(in srgb, var(--primary), white 68%);
    border-bottom: 1px solid color-mix(in srgb, var(--primary), white 68%);
    border-radius: 0 0 16px 0;
    background: color-mix(in srgb, var(--surface), white 25%);
  }

  .service-card h3 {
    font-size: 1.1rem;
  }

  .service-cta {
    justify-self: start;
    text-decoration: none;
    font-size: 0.74rem;
    border: 1px solid color-mix(in srgb, #25d366, black 16%);
    color: #157347;
    background: color-mix(in srgb, #25d366, white 90%);
    border-radius: 999px;
    padding: 0.22rem 0.5rem;
  }

  .service-media {
    margin: -0.3rem -0.2rem 0.35rem;
    min-height: 160px;
    border: 1px solid color-mix(in srgb, var(--primary), white 66%);
    overflow: hidden;
  }

  .service-media img {
    width: 100%;
    height: 100%;
    min-height: 160px;
    object-fit: cover;
  }

  .media-fallback {
    min-height: 160px;
    display: grid;
    place-items: center;
    background:
      radial-gradient(100px 70px at 85% 12%, color-mix(in srgb, var(--accent), white 40%), transparent 54%),
      linear-gradient(140deg, color-mix(in srgb, var(--surface), white 30%), color-mix(in srgb, var(--bg-elevated), white 12%));
  }

  .media-fallback.fallback {
    display: none;
  }

  .service-card.editorial {
    border-left-color: color-mix(in srgb, var(--primary), white 45%);
    border-bottom-color: color-mix(in srgb, var(--primary), white 48%);
    box-shadow: 0 18px 40px -32px var(--glow);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--surface), white 20%), color-mix(in srgb, var(--bg-elevated), white 15%));
  }
</style>
