---
import type { FaqItem } from "../types";

type Props = {
  items: FaqItem[];
};

const { items } = Astro.props;
---

<section class="section faq-accordion">
  <div class="container">
    <h2>Sık Sorulan Sorular</h2>
    <div class="list">
      {
        items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <div class="answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-accordion {
    padding-top: 1.4rem;
  }

  .list {
    margin-top: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--primary), white 68%);
  }

  details {
    padding: 0.8rem 0.1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--primary), white 74%);
  }

  summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    padding-right: 1.2rem;
    position: relative;
  }

  summary::after {
    content: "+";
    position: absolute;
    right: 0;
    top: 0;
    color: var(--muted);
  }

  details[open] summary::after {
    content: "−";
  }

  .answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 260ms ease;
    opacity: 0.2;
  }

  details[open] .answer {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .answer p {
    overflow: hidden;
    margin-top: 0.55rem;
    color: var(--muted);
    max-width: 72ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .answer {
      transition: none;
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }
</style>
