---
import type { FaqItem } from "../types";

type Props = {
  items: FaqItem[];
};

const { items } = Astro.props;
---

<section class="section faq-accordion">
  <div class="container">
    <h2>Sık Sorulan Sorular</h2>
    <div class="list">
      {
        items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-accordion {
    padding-top: 1.4rem;
  }

  .list {
    margin-top: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--primary), white 68%);
  }

  details {
    padding: 0.9rem 0.1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--primary), white 74%);
  }

  summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    padding-right: 1.2rem;
    position: relative;
  }

  summary::after {
    content: "+";
    position: absolute;
    right: 0;
    top: 0;
    color: var(--muted);
  }

  details[open] summary::after {
    content: "−";
  }

  p {
    margin-top: 0.55rem;
    color: var(--muted);
    max-width: 72ch;
  }
</style>
