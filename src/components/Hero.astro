---
import type { Business, Theme } from "../types";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import { getHeroMedia } from "../lib/assets";
import EditorialVisualFallback from "./EditorialVisualFallback.astro";

type Props = {
  business: Business;
  theme: Theme;
  h1: string;
  summary: string;
};

const { business, theme, h1, summary } = Astro.props;
void theme;
const isBridal = business.tone === "bridal-editorial" || business.themeId === "bridal-editorial-luxe";
const heroImage = getHeroMedia(business);
const whatsApp = buildWhatsAppUrl(business);
---

<section class={`hero ${isBridal ? "bridal" : ""}`}>
  <div class="container">
    <div class="hero-media-wrap">
      {
        heroImage ? (
          <>
            <img
              src={heroImage}
              alt={`${business.businessName} için ${business.mainService} görseli`}
              width="900"
              height="1200"
              loading="eager"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
            />
            <div class="fallback visual-fallback" aria-hidden="true">
              <EditorialVisualFallback theme={business.themeId} aspectRatio="3/4" />
            </div>
          </>
        ) : (
          <div class="visual-fallback">
            <EditorialVisualFallback theme={business.themeId} aspectRatio="3/4" />
          </div>
        )
      }
      <div class="overlay"></div>
      <div class="copy-panel">
        <p class="eyebrow">{isBridal ? "Gaziosmanpaşa · Gelin Saçı ve Makyajı" : business.hero.eyebrow}</p>
        <h1>{isBridal ? "Özel gününüz için saç ve makyajı zarif bir akışla planlayın." : h1}</h1>
        <p class="descriptor">
          {
            isBridal
              ? "Gaziosmanpaşa’da gelin, kına, nişan ve davet hazırlıkları için hizmetleri inceleyin, WhatsApp üzerinden randevu bilgisi alın."
              : summary
          }
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={whatsApp} target="_blank" rel="noreferrer">WhatsApp’tan Randevu Bilgisi Al</a>
          <a class="btn btn-secondary" href={`/demo/${business.slug}/hizmetler/`}>Hizmetleri İncele</a>
        </div>
        <p class="trust-line">Gelin · Kına · Nişan · Davet</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(1rem, 3vw, 2rem) 0 clamp(1.6rem, 3.5vw, 2.8rem);
  }

  .hero-media-wrap {
    position: relative;
    min-height: clamp(500px, 72vh, 740px);
    border: 1px solid color-mix(in srgb, var(--primary), white 64%);
    overflow: hidden;
    background: color-mix(in srgb, var(--surface), white 10%);
  }

  .hero-media-wrap img,
  .visual-fallback {
    width: 100%;
    height: 100%;
    min-height: clamp(500px, 72vh, 740px);
  }

  .hero-media-wrap img {
    object-fit: cover;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(104deg, rgba(26, 16, 13, 0.58) 14%, rgba(34, 20, 15, 0.34) 48%, rgba(34, 20, 15, 0.08) 78%),
      linear-gradient(180deg, rgba(26, 16, 13, 0.03), rgba(26, 16, 13, 0.22));
  }

  .copy-panel {
    position: absolute;
    left: clamp(0.8rem, 2vw, 1.5rem);
    bottom: clamp(0.8rem, 2vw, 1.5rem);
    max-width: min(640px, calc(100% - 1.6rem));
    display: grid;
    gap: 0.72rem;
    padding: clamp(0.85rem, 1.8vw, 1.15rem);
    border: 1px solid rgba(255, 255, 255, 0.34);
    background: rgba(255, 250, 246, 0.14);
    backdrop-filter: blur(6px);
  }

  .copy-panel h1 {
    color: #fff8f4;
    max-width: 22ch;
  }

  .eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #f6e5d8;
    font-weight: 700;
  }

  .descriptor {
    font-size: clamp(0.94rem, 1.35vw, 1.06rem);
    color: #f8ede5;
    max-width: 52ch;
  }

  .actions {
    display: flex;
    gap: 0.52rem;
    flex-wrap: wrap;
  }

  .actions .btn {
    font-size: 0.82rem;
    padding-inline: 0.88rem;
    min-height: 38px;
  }

  .actions .btn-secondary {
    border-color: rgba(255, 255, 255, 0.52);
    background: rgba(255, 255, 255, 0.1);
    color: #fff5ef;
  }

  .trust-line {
    font-size: 0.77rem;
    color: #ecd8ca;
    letter-spacing: 0.04em;
  }

  .fallback {
    display: none;
  }

  @media (max-width: 920px) {
    .hero-media-wrap {
      min-height: clamp(520px, 84vh, 680px);
    }

    .hero-media-wrap img,
    .visual-fallback {
      min-height: clamp(520px, 84vh, 680px);
    }

    .copy-panel {
      inset: auto 0.6rem 0.6rem 0.6rem;
      max-width: none;
    }

    .actions {
      gap: 0.44rem;
    }

    .actions .btn {
      flex: 1 1 auto;
      justify-content: center;
      min-width: 150px;
    }
  }
</style>
