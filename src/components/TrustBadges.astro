---
import type { Business } from "../types";

type Props = {
  badges: string[];
  business?: Business;
};

const { badges, business } = Astro.props;
const featureItems =
  business?.trustFeatures?.length && business.trustFeatures.length > 0
    ? business.trustFeatures
    : badges.slice(0, 4).map((badge) => ({
        heading: badge,
        description: "Randevu sürecini sadeleştiren planlı hizmet akışı."
      }));
---

<section class="section trust">
  <div class="container">
    <h2>Neden Tercih Ediliyor?</h2>
    <ul class="grid trust-grid" role="list">
      {
        featureItems.map((item, index) => (
          <li class="card feature-item">
            <span class="num">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.heading}</h3>
            <p>{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust-grid {
    margin-top: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    list-style: none;
    padding: 0;
  }

  .feature-item {
    padding: 1rem;
    display: grid;
    gap: 0.42rem;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--primary), white 66%);
    background:
      radial-gradient(circle at 90% -5%, color-mix(in srgb, var(--accent), white 50%), transparent 48%),
      color-mix(in srgb, var(--surface), white 18%);
  }

  .num {
    width: fit-content;
    font-size: 0.72rem;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--primary), white 58%);
    color: color-mix(in srgb, var(--primary), black 15%);
    font-weight: 700;
  }

  .feature-item h3 {
    font-size: 1rem;
    line-height: 1.2;
  }

  .feature-item p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    .trust-grid {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .feature-item {
      padding: 0.9rem;
    }
  }
</style>
