---
import type { Business, ServiceItem } from "../types";
import ServiceDetailBlock from "./ServiceDetailBlock.astro";

type Props = {
  business: Business;
  services: ServiceItem[];
};

const { business, services } = Astro.props;
---

<section class="section service-menu-section">
  <div class="container">
    <div class="dossier-layout">
      <aside class="dossier-intro">
        <p class="eyebrow">Hizmet Dosyası</p>
        <h2>Hizmet Detayları</h2>
        <p class="menu-note">Her hizmet için kısa detayları inceleyip doğrudan WhatsApp üzerinden randevu bilgisi alabilirsiniz.</p>
      </aside>
      <div class="service-list">
        {services.map((service, index) => <ServiceDetailBlock business={business} service={service} index={index} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .service-menu-section {
    padding-top: 1rem;
  }

  .dossier-layout {
    display: grid;
    grid-template-columns: minmax(210px, 0.35fr) 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  .dossier-intro {
    position: sticky;
    top: 82px;
    display: grid;
    gap: 0.45rem;
  }

  .menu-note {
    color: var(--muted);
    max-width: 34ch;
  }

  .service-list {
    border-top: 1px solid color-mix(in srgb, var(--primary), white 66%);
  }

  @media (max-width: 980px) {
    .dossier-layout {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .dossier-intro {
      position: static;
    }
  }
</style>
