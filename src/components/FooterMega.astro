---
import type { Business } from "../types";
import { getBusinessLogo } from "../lib/assets";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import { slugify } from "../lib/slugify";

type Props = {
  business: Business;
  basePath: string;
};

const { business, basePath } = Astro.props;

const logo = getBusinessLogo(business);
const services = business.services.slice(0, 8);
const hasAbout = Boolean(business.cta?.description);
const hasGallery = Boolean(business.instagramUrl) || business.moduleOrder.home.includes("instagramPreviewGrid");
const whatsappUrl = buildWhatsAppUrl(business);
const isRitualCommerce = business.archetype === "soft-beauty-editorial" && business.tone === "bridal-editorial";
const formatLocalPhone = (phone: string) => {
  const digits = phone.replace(/\D/g, "");
  const local = digits.startsWith("90") ? `0${digits.slice(2)}` : digits;
  return local.length === 11 ? `${local.slice(0, 4)} ${local.slice(4, 7)} ${local.slice(7, 9)} ${local.slice(9)}` : phone;
};
const formattedPhone = formatLocalPhone(business.phone);
const instagramHandle = (() => {
  try {
    const pathname = new URL(business.instagramUrl).pathname.replace(/^\/+|\/+$/g, "");
    return pathname ? `@${pathname.split("/")[0]}` : "Instagram";
  } catch {
    return "Instagram";
  }
})();
---

<footer class:list={["footer-mega", isRitualCommerce && "ritual-footer"]}>
  <div class="container footer-grid">
    <section class="brand-col">
      <a class="brand-link" href={basePath}>
        {
          logo ? (
            <>
              <img
                src={logo}
                alt={`${business.businessName} logosu`}
                class="brand-logo"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';"
              />
              <span class="brand-fallback">{business.businessName}</span>
            </>
          ) : (
            <span class="brand-title">{business.businessName}</span>
          )
        }
      </a>
      <p class="brand-summary">
        {
          business.slug === "simay-sarikaya-hair-makeup"
            ? "Gaziosmanpaşa ve çevresinde gelin saçı ve makyajı odaklı, randevu ve iletişimi kolaylaştıran stüdyo deneyimi."
            : `${business.district} ve çevresinde ${business.mainService.toLocaleLowerCase("tr-TR")} odaklı, randevu ve iletişimi kolaylaştıran stüdyo deneyimi.`
        }
      </p>
    </section>

    <section>
      <h3>Sayfalar</h3>
      <ul>
        <li><a href={basePath}>Ana Sayfa</a></li>
        <li><a href={`${basePath}hizmetler/`}>Hizmetler</a></li>
        <li><a href={`${basePath}randevu/`}>Randevu & İletişim</a></li>
        {hasAbout && <li><a href={`${basePath}randevu/#hakkimizda`}>Hakkımızda</a></li>}
        {hasGallery && <li><a href={`${basePath}#galeri`}>Galeri / Instagram</a></li>}
      </ul>
    </section>

    <section>
      <h3>Hizmetler</h3>
      <ul>
        {
          services.map((service) => (
            <li>
              <a href={`${basePath}hizmetler/#${slugify(service.name)}`}>{service.name}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h3>İletişim</h3>
      <ul class="contact-list">
        <li class="contact-primary"><a href={`tel:${business.phone}`}>{formattedPhone}</a></li>
        <li class="contact-primary"><a href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp’tan Yazın</a></li>
        <li class="contact-primary">
          <a href={business.instagramUrl} target="_blank" rel="noreferrer" class="social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
              <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
              <circle cx="17.1" cy="6.9" r="1" fill="currentColor"></circle>
            </svg>
            <span>{instagramHandle}</span>
          </a>
        </li>
        <li class="contact-location">{business.neighborhood}, {business.district}</li>
        <li class="contact-location">
          <a
            href={business.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${business.businessName} için Google Maps yol tarifi`}
          >
            Google Maps / Yol Tarifi
          </a>
        </li>
      </ul>
    </section>
  </div>

  <div class="container footer-bottom">
    <p>© 2026 {business.businessName}. Tüm hakları saklıdır.</p>
    <p class="credit">Web tasarım ve bakım: <a href="https://aydemirs.com" target="_blank" rel="noreferrer">aydemirs.com</a></p>
    <p class="demo-note">
      Demo görseller temsili olarak kullanılmıştır. Yayın öncesi işletmenin kendi görselleriyle değiştirilebilir.
    </p>
  </div>
</footer>

<style>
  .footer-mega {
    margin-top: 1.5rem;
    padding: 1.8rem 0 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--primary), white 72%);
    background:
      radial-gradient(360px 180px at 10% 0%, color-mix(in srgb, var(--accent), white 76%), transparent 66%),
      linear-gradient(180deg, color-mix(in srgb, var(--surface), white 16%), color-mix(in srgb, var(--bg), white 10%));
  }

  .footer-mega.ritual-footer {
    margin-top: 0;
    padding: clamp(2.2rem, 5vw, 4rem) 0 1rem;
    background: linear-gradient(180deg, #e7f3ff, #dfeeff);
    border-top: 1px solid #cadff4;
    color: #071a3c;
  }

  .ritual-footer .footer-grid {
    grid-template-columns: 1.45fr 0.9fr 1.1fr 1.1fr;
    gap: 1.2rem clamp(1rem, 4vw, 3rem);
  }

  .ritual-footer .brand-title,
  .ritual-footer .brand-fallback {
    font-family: "Space Grotesk", var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.6rem);
    line-height: 1;
    color: #071a3c;
  }

  .ritual-footer h3 {
    color: #324767;
    letter-spacing: 0;
    text-transform: none;
    font-family: "Space Grotesk", var(--font-heading);
    font-size: 1rem;
  }

  .ritual-footer li,
  .ritual-footer a,
  .ritual-footer .brand-summary {
    color: #263a5c;
  }

  .ritual-footer .contact-list a[href*="wa.me"],
  .ritual-footer a:hover,
  .ritual-footer .credit a {
    color: #071f63;
  }

  .ritual-footer .footer-bottom {
    border-top-color: #c9ddf2;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1fr;
    gap: 0.85rem 1.1rem;
    min-width: 0;
  }

  .footer-grid > section {
    min-width: 0;
  }

  .brand-link {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    max-width: 100%;
  }

  .brand-logo {
    height: 40px;
    width: auto;
    max-width: 240px;
    object-fit: contain;
  }

  .brand-title,
  .brand-fallback {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-fallback {
    display: none;
  }

  h3 {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.38rem;
  }

  li,
  a {
    font-size: 0.84rem;
    color: color-mix(in srgb, var(--text), white 14%);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a:hover {
    color: var(--primary);
  }

  .brand-summary {
    margin: 0.52rem 0 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.5;
    max-width: 32ch;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.33rem;
  }

  .social-link svg {
    width: 12px;
    height: 12px;
  }

  .contact-list a[href*="wa.me"] {
    color: #157347;
    font-weight: 700;
  }

  .footer-bottom {
    margin-top: 1rem;
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in srgb, var(--primary), white 76%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem 0.9rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .footer-bottom p {
    margin: 0;
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .credit a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 700;
  }

  .credit {
    opacity: 0.5;
  }

  .demo-note {
    flex-basis: 100%;
    max-width: 68ch;
  }

  @media (max-width: 980px) {
    .footer-grid,
    .ritual-footer .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 700px) {
    .footer-mega {
      margin-top: 1rem;
      padding-top: 1.2rem;
    }

    .footer-grid,
    .ritual-footer .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.86rem 1rem;
    }

    .footer-mega.ritual-footer {
      padding-top: 1.35rem;
    }

    .footer-grid > .brand-col,
    .footer-grid > section:nth-child(4) {
      grid-column: 1 / -1;
    }

    .ritual-footer .footer-grid > section:nth-child(4) h3 {
      text-align: center;
    }

    .ritual-footer .contact-list {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.34rem 0.9rem;
      align-items: start;
    }

    .ritual-footer .contact-list .contact-primary {
      grid-column: 1;
    }

    .ritual-footer .contact-list .contact-location {
      grid-column: 2;
      text-align: right;
      justify-self: end;
    }

    .brand-logo {
      height: 30px;
      max-width: 176px;
    }

    h3 {
      margin-bottom: 0.35rem;
    }

    ul {
      gap: 0.3rem;
    }

    li,
    a,
    .brand-summary {
      font-size: 0.8rem;
    }

    .footer-bottom {
      margin-top: 0.8rem;
      padding-top: 0.55rem;
      display: grid;
      justify-content: stretch;
      gap: 0.48rem;
    }
  }
</style>
