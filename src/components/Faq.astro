---
import type { FaqItem } from "../types";

type Props = {
  items: FaqItem[];
};

const { items } = Astro.props;
---

<section class="section">
  <div class="container">
    <h2>Sık Sorulan Sorular</h2>
    <div class="faq-list">
      {
        items.map((item) => (
          <details class="card">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.7rem;
  }

  details {
    padding: 0.85rem 1rem;
  }

  summary {
    cursor: pointer;
    font-weight: 700;
  }

  details p {
    margin-top: 0.6rem;
  }
</style>
