---
import "../../../styles/simay-warm-spa.css";

const routes = {
  home: "/style-lab/simay-warm-spa/",
  services: "/style-lab/simay-warm-spa/hizmetler/",
  contact: "/style-lab/simay-warm-spa/randevu/",
};

const whatsappMessage = encodeURIComponent(
  "Merhaba, hizmetleriniz ve randevu bilgisi hakkında bilgi almak istiyorum.",
);
const whatsappUrl = `https://wa.me/905337774545?text=${whatsappMessage}`;

const blocks = [
  ["Gelin Saçı ve Makyajı", "Düğün konsepti, gelinlik ve çekim planına göre saç ve makyaj hazırlığı planlanır.", "/assets/businesses/simay-sarikaya/service-makeup-01.jpg"],
  ["Kına Hazırlığı", "Kına gecesi konsepti, kıyafet ve sahne ışığına uyumlu görünüm oluşturulur.", "/assets/businesses/simay-sarikaya/service-hair-01.jpg"],
  ["Nişan Hazırlığı", "Nişan günü için daha zarif, fotoğrafa hazır ve dengeli bir saç-makyaj akışı hazırlanır.", "/assets/businesses/simay-sarikaya/grid-02.jpg"],
  ["Davet Makyajı", "Özel davetler, doğum günü ve etkinlikler için sade ya da belirgin makyaj seçenekleri sunulur.", "/assets/businesses/simay-sarikaya/grid-03.jpg"],
  ["Özel Gün Saç Tasarımı", "Topuz, dalga, fön ve konsept saç tasarımı gibi özel gün hazırlıkları planlanır.", "/assets/businesses/simay-sarikaya/pexels-kerimeveyik-22589552.jpg"],
];
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Simay Sarıkaya | Sıcak Lüks Hizmetler</title>
    <meta name="description" content="Sıcak lüks yönünde Simay Sarıkaya hizmetler sayfası." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://example.com/style-lab/simay-warm-spa/hizmetler/" />
  </head>
  <body>
    <div class="sw-root">
      <header class="sw-top">
        <div class="sw-shell sw-row">
          <a class="sw-brand" href={routes.home}><strong>Simay Sarıkaya</strong><span>Gelin Saçı ve Makyajı</span></a>
          <nav class="sw-nav-d"><a href={routes.home}>Ana Sayfa</a><a href={routes.services}>Hizmetler</a><a href={routes.contact}>Randevu & İletişim</a><a class="sw-icon" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a></nav>
          <div class="sw-nav-m"><a class="sw-icon" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a><details class="sw-menu"><summary class="sw-menu-btn" aria-label="Menü"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg></summary><nav class="sw-menu-box"><a href={routes.home}>Ana Sayfa</a><a href={routes.services}>Hizmetler</a><a href={routes.contact}>Randevu & İletişim</a></nav></details></div>
        </div>
      </header>

      <main class="sw-main">
        <div class="sw-shell">
          <p class="sw-kicker">Hizmetler</p>
          <h1 class="sw-h1">Hizmetler</h1>
          <p class="sw-lead">Gelin, kına, nişan ve davet hazırlıkları için saç ve makyaj hizmetlerini tek sayfada inceleyin.</p>

          <section class="sw-cat">
            {
              blocks.map(([title, desc, img]) => (
                <article class="sw-block">
                  <figure class="sw-block-media"><img src={img} alt={title} loading="lazy" onerror="this.style.display='none'" /></figure>
                  <div>
                    <h2>{title}</h2>
                    <p>{desc}</p>
                    <div class="sw-actions"><a class="sw-btn sw-btn-main" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp’tan Randevu Bilgisi Al</a></div>
                  </div>
                </article>
              ))
            }
          </section>

          <section class="sw-main" style="padding-top:1rem">
            <div class="sw-card">
              <h2>Sık sorulan sorular</h2>
              <div class="sw-rowline"><span>Randevu bilgisi nasıl alınır?</span><strong>WhatsApp ile</strong></div>
              <div class="sw-rowline"><span>Fiyat bilgisi nasıl veriliyor?</span><strong>Hizmet kapsamına göre</strong></div>
              <div class="sw-rowline"><span>Gelin, kına ve nişan ayrı alınabilir mi?</span><strong>Evet, ayrı planlanabilir</strong></div>
              <div class="sw-rowline"><span>Stüdyoya nasıl ulaşabilirim?</span><strong>Google Maps yol tarifi</strong></div>
            </div>
          </section>
        </div>
      </main>

      <footer class="sw-foot">
        <div class="sw-shell">
          <div class="sw-cols">
            <section><h3>Marka</h3><ul><li>Simay Sarıkaya</li><li>Gelin Saçı ve Makyajı</li><li>Gaziosmanpaşa · İstanbul</li></ul></section>
            <section><h3>Sayfalar</h3><ul><li><a href={routes.home}>Ana Sayfa</a></li><li><a href={routes.services}>Hizmetler</a></li><li><a href={routes.contact}>Randevu & İletişim</a></li></ul></section>
            <section><h3>Hizmetler</h3><ul><li>Gelin Saçı ve Makyajı</li><li>Kına Hazırlığı</li><li>Nişan Hazırlığı</li><li>Davet Makyajı</li><li>Özel Gün Saç Tasarımı</li></ul></section>
            <section><h3>İletişim</h3><ul><li><a href="tel:+902126104545">+90 212 610 45 45</a></li><li><a href={whatsappUrl}>WhatsApp</a></li><li><a href="https://instagram.com/simaysarikayahairmakeup">Instagram</a></li><li><a href="https://maps.google.com/?q=Gaziosmanpasa+Istanbul">Yol Tarifi</a></li></ul></section>
          </div>
          <div class="sw-credit"><strong>Web tasarım ve bakım: aydemirs.com</strong><span>Demo görseller temsili olarak kullanılmıştır. Yayın öncesi işletmenin kendi görselleriyle değiştirilebilir.</span></div>
        </div>
      </footer>

      <a class="sw-float" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp hızlı erişim"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a>
    </div>
  </body>
</html>
