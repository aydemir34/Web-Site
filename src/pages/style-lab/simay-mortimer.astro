---
const business = {
  name: "Simay Sarıkaya Hair & Makeup Studio",
  district: "Gaziosmanpaşa",
  phone: "+90 212 610 45 45",
  phoneHref: "tel:+902126104545",
  whatsappNumber: "905337774545",
  instagramUrl: "https://instagram.com/simaysarikayahairmakeup",
  mapUrl: "https://maps.google.com/?q=Gaziosmanpasa+Istanbul",
