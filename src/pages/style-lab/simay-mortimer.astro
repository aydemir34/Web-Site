const servicePanels = [
  {
    title: "Gelin Saçı ve Makyajı",
    description: "Prova gününden düğün sabahına kadar tek akışta planlanır.",
    image: serviceMakeupImage,
    tone: "rose",
  },
  {
    title: "Kına Hazırlığı",
    description: "Kıyafet, ışık ve sahneye uyumlu dengeli görünüm hazırlanır.",
    image: serviceHairImage,
    tone: "gold",
  },
  {
    title: "Nişan Hazırlığı",
    description: "Yüz hatlarını öne çıkaran zarif saç ve makyaj kurgulanır.",
    image: serviceMakeupImage,
    tone: "cocoa",
  },
  {
    title: "Davet Makyajı",
    description: "Uzun süren davetler için kalıcı ve doğal görünüm hedeflenir.",
    image: serviceHairImage,
    tone: "ink",
  },
];

const menuRows = [
  {
    no: "01",
    title: "Gelin Saçı ve Makyajı",
    description:
      "Konsept, gelinlik ve çekim planına göre prova destekli hazırlık akışı oluşturulur.",
  },
  {
    no: "02",
    title: "Kına Hazırlığı",
    description:
      "Kına gecesi için kıyafet tonu, ışık yapısı ve sahne temposuna uygun saç-makyaj dengesi kurulur.",
  },
  {
    no: "03",
    title: "Nişan Hazırlığı",
    description:
      "Nişan konseptine göre sade ama güçlü bir görünüm için özel uygulama planı hazırlanır.",
  },
  {
    no: "04",
    title: "Davet Makyajı",
    description: "Davet süresince canlı görünüm koruyan, cilt tipine uygun makyaj uygulanır.",
  },
];

const galleryCandidates = [
  "/assets/businesses/simay-sarikaya/grid-01.jpg",
  "/assets/businesses/simay-sarikaya/grid-02.jpg",
  "/assets/businesses/simay-sarikaya/grid-03.jpg",
  serviceMakeupImage,
  serviceHairImage,
  heroImage,
];
const galleryImages = galleryCandidates.slice(0, 6);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Simay Sarıkaya | Stil Laboratuvarı</title>
    <meta
      name="description"
      content="Simay Sarıkaya için premium saç ve makyaj görsel yönü denemesi."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://example.com/style-lab/simay-mortimer" />
    <meta property="og:title" content="Simay Sarıkaya | Stil Laboratuvarı" />
    <meta
      property="og:description"
      content="Saç ve makyaj stüdyosu için sıcak, editoryal ve yüksek yoğunluklu tek sayfa yön denemesi."
    />
    <style>
      :root {
        --cream: #f6f2ea;
        --paper: #fffdf9;
        --ink: #170d0d;
        --chocolate: #4c292b;
        --rose: #b98d8e;
        --taupe: #8f7773;
        --line: #dccfc0;
        --dark: #12090a;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Figtree", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
        color: var(--ink);
        background: var(--paper);
      }

      a {
        color: inherit;
      }

      .container {
        width: min(1200px, calc(100% - 2.25rem));
        margin-inline: auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        border-bottom: 1px solid var(--line);
        background: color-mix(in srgb, var(--paper) 88%, white 12%);
        backdrop-filter: blur(6px);
      }

      .header-inner {
        min-height: 62px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .brand {
        display: grid;
        gap: 0.2rem;
      }

      .brand strong {
        font-family: "Iowan Old Style", "Times New Roman", serif;
        font-size: clamp(1rem, 2.3vw, 1.2rem);
        letter-spacing: 0;
      }

      .brand span {
        font-size: 0.69rem;
        color: color-mix(in srgb, var(--ink) 66%, white 34%);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .desktop-nav {
        display: none;
        align-items: center;
        gap: 1.15rem;
        font-size: 0.82rem;
      }

      .desktop-nav a:not(.mini-wa) {
        text-decoration: none;
        border-bottom: 1px solid transparent;
        padding-bottom: 0.18rem;
      }

      .desktop-nav a:hover {
        border-color: var(--chocolate);
      }

      .mini-wa,
      .mobile-icon {
        width: 2.2rem;
        height: 2.2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--chocolate);
        border-radius: 3px;
        background: transparent;
      }

      .mini-wa svg,
      .mobile-icon svg {
        width: 1rem;
        height: 1rem;
      }

      .mobile-actions {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }

      .mobile-menu {
        position: relative;
      }

      .mobile-menu summary {
        list-style: none;
      }

      .mobile-menu summary::-webkit-details-marker {
        display: none;
      }

      .mobile-menu-list {
        position: absolute;
        right: 0;
        top: calc(100% + 0.5rem);
        min-width: 11.5rem;
        border: 1px solid var(--line);
        background: var(--paper);
        padding: 0.5rem;
        display: grid;
        gap: 0.2rem;
      }

      .mobile-menu-list a {
        text-decoration: none;
        font-size: 0.85rem;
        padding: 0.5rem 0.45rem;
      }

      .mobile-menu-list a:hover {
        background: color-mix(in srgb, var(--cream) 84%, white 16%);
      }

      .hero {
        min-height: calc(100svh - 63px);
        position: relative;
        overflow: clip;
      }

      .hero-media {
        position: absolute;
        inset: 0;
      }

      .hero-media img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero-media::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(18, 9, 10, 0.7) 0%, rgba(18, 9, 10, 0.25) 45%, rgba(18, 9, 10, 0.68) 100%),
          linear-gradient(180deg, rgba(18, 9, 10, 0.12) 0%, rgba(18, 9, 10, 0.74) 100%);
      }

      .hero-fallback {
        width: 100%;
        height: 100%;
        background:
          radial-gradient(circle at 16% 26%, rgba(185, 141, 142, 0.6), transparent 43%),
          radial-gradient(circle at 79% 18%, rgba(143, 119, 115, 0.34), transparent 44%),
          linear-gradient(130deg, #2f191a 0%, #100809 58%, #2e1c1f 100%);
      }

      .hero-content {
        position: relative;
        z-index: 2;
        min-height: calc(100svh - 63px);
        display: flex;
        align-items: flex-end;
        padding: clamp(1.25rem, 5vw, 3.5rem) 0 clamp(1.1rem, 4vw, 2.75rem);
      }

      .hero-copy {
        width: min(43rem, 100%);
        color: #fff;
      }

      .hero-copy p {
        margin: 0;
      }

      .hero-eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.73rem;
        color: rgba(255, 255, 255, 0.85);
      }

      h1 {
        margin: 0.75rem 0 0;
        font-family: "Iowan Old Style", "Times New Roman", serif;
        font-size: clamp(1.85rem, 4.5vw, 3.7rem);
        line-height: 1.08;
        max-width: 17ch;
      }

      .hero-desc {
        margin-top: 1rem;
        color: rgba(255, 255, 255, 0.88);
        max-width: 52ch;
        font-size: clamp(0.95rem, 2vw, 1.05rem);
        line-height: 1.6;
      }

      .hero-cta {
        margin-top: 1.3rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.58rem;
      }

      .cta-btn {
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.65);
        padding: 0.66rem 0.9rem;
        font-size: 0.82rem;
        border-radius: 3px;
      }

      .cta-btn.primary {
        background: #fff;
        color: var(--ink);
        border-color: #fff;
      }

      .service-strip {
        padding: clamp(1.1rem, 3vw, 1.7rem) 0 0;
      }

      .strip-grid {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(74%, 1fr);
        gap: 0.7rem;
        overflow-x: auto;
        padding-bottom: 0.35rem;
        scroll-snap-type: x mandatory;
      }

      .service-panel {
        position: relative;
        min-height: clamp(22rem, 48vh, 30rem);
        overflow: clip;
        scroll-snap-align: start;
        background: #1a1213;
      }

      .service-panel::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(180deg, rgba(18, 9, 10, 0.14) 0%, rgba(18, 9, 10, 0.84) 100%),
          var(--panel-image),
          linear-gradient(135deg, #3e2324 0%, #180d0f 100%);
        background-size: cover;
        background-position: center;
      }

      .service-panel.tone-rose::before {
        background:
          linear-gradient(180deg, rgba(18, 9, 10, 0.12) 0%, rgba(18, 9, 10, 0.88) 100%),
          var(--panel-image),
          radial-gradient(circle at 70% 20%, color-mix(in srgb, var(--rose) 72%, white 28%), transparent 52%),
          linear-gradient(135deg, #3e2324 0%, #180d0f 100%);
      }

      .service-panel.tone-gold::before {
        background:
          linear-gradient(180deg, rgba(18, 9, 10, 0.14) 0%, rgba(18, 9, 10, 0.87) 100%),
          var(--panel-image),
          radial-gradient(circle at 20% 16%, #a47f5a, transparent 44%),
          linear-gradient(135deg, #4d3524 0%, #170d0f 100%);
      }

      .service-panel.tone-cocoa::before {
        background:
          linear-gradient(180deg, rgba(18, 9, 10, 0.12) 0%, rgba(18, 9, 10, 0.9) 100%),
          var(--panel-image),
          radial-gradient(circle at 24% 22%, #8f7773, transparent 48%),
          linear-gradient(130deg, #2e1a18 0%, #13090a 100%);
      }

      .service-panel.tone-ink::before {
        background:
          linear-gradient(180deg, rgba(18, 9, 10, 0.16) 0%, rgba(18, 9, 10, 0.94) 100%),
          var(--panel-image),
          radial-gradient(circle at 76% 20%, #60494a, transparent 50%),
          linear-gradient(130deg, #241415 0%, #090304 100%);
      }

      .service-caption {
        position: absolute;
        left: 0.75rem;
        right: 0.75rem;
        bottom: 0.75rem;
        border: 1px solid rgba(255, 255, 255, 0.24);
        background: rgba(20, 11, 12, 0.46);
        backdrop-filter: blur(5px);
        color: #fff;
        padding: 0.8rem;
      }

      .service-caption h2 {
        margin: 0;
        font-family: "Iowan Old Style", "Times New Roman", serif;
        font-size: clamp(1rem, 2vw, 1.25rem);
      }

      .service-caption p {
        margin: 0.35rem 0 0;
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.86);
      }

      .menu-section {
        margin-top: clamp(2rem, 6vw, 3.9rem);
        background: var(--dark);
        color: #fff;
      }

      .menu-inner {
        padding: clamp(1.35rem, 4vw, 2.7rem) 0;
      }

      .menu-kicker {
        font-size: 0.74rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.72);
        margin: 0;
      }

      .menu-title {
        margin: 0.45rem 0 0;
        font-family: "Iowan Old Style", "Times New Roman", serif;
        font-size: clamp(1.45rem, 3.9vw, 2.55rem);
      }

      .menu-list {
        margin-top: 1.1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.18);
      }

      .menu-row {
        display: grid;
        gap: 0.55rem;
        padding: 0.95rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      }

      .menu-row-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.8rem;
      }

      .menu-no {
        color: rgba(255, 255, 255, 0.54);
        font-size: 0.74rem;
        letter-spacing: 0.08em;
      }

      .menu-row h3 {
        margin: 0;
        font-family: "Iowan Old Style", "Times New Roman", serif;
        font-size: clamp(1.12rem, 2.8vw, 1.62rem);
      }

      .menu-row p {
        margin: 0;
        color: rgba(255, 255, 255, 0.83);
        font-size: 0.93rem;
        line-height: 1.6;
        max-width: 64ch;
      }

      .menu-row .row-cta {
        justify-self: start;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.48);
        border-radius: 3px;
        padding: 0.48rem 0.8rem;
        font-size: 0.79rem;
      }

      .gallery {
        padding: clamp(2rem, 5vw, 3.4rem) 0 0.5rem;
      }

      .gallery h2 {
        margin: 0;
        font-family: "Iowan Old Style", "Times New Roman", serif;
        font-size: clamp(1.3rem, 3.3vw, 2.2rem);
      }

      .gallery-strip {
        margin-top: 0.9rem;
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(72%, 1fr);
        gap: 0.7rem;
        overflow-x: auto;
        padding-bottom: 0.45rem;
        scroll-snap-type: x mandatory;
      }

      .gallery-item {
        min-height: clamp(12rem, 34vh, 17rem);
        position: relative;
        overflow: clip;
        scroll-snap-align: start;
        background:
          radial-gradient(circle at 24% 20%, #b98d8e, transparent 50%),
          linear-gradient(120deg, #3b2022 0%, #14090b 100%);
      }

      .gallery-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .contact-strip {
        padding: clamp(1.9rem, 5vw, 3.2rem) 0;
      }

      .contact-shell {
        border: 1px solid var(--line);
        background: var(--cream);
        padding: clamp(0.95rem, 3.2vw, 1.5rem);
      }

      .contact-shell h2 {
        margin: 0;
        font-family: "Iowan Old Style", "Times New Roman", serif;
        font-size: clamp(1.2rem, 3.2vw, 2rem);
      }

      .contact-grid {
        margin-top: 0.85rem;
        display: grid;
        gap: 0.45rem;
      }

      .contact-line {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 0.45rem;
        border-bottom: 1px solid color-mix(in srgb, var(--line) 90%, white 10%);
        font-size: 0.92rem;
      }

      .contact-line span {
        color: color-mix(in srgb, var(--ink) 62%, white 38%);
      }

      .compact-footer {
        border-top: 1px solid var(--line);
        padding: 1.25rem 0 1.6rem;
      }

      .footer-grid {
        display: grid;
        gap: 1.1rem;
      }

      .footer-col h3 {
        margin: 0 0 0.35rem;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      .footer-col ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.25rem;
      }

      .footer-col a,
      .footer-col li {
        text-decoration: none;
        font-size: 0.84rem;
      }

      .credit {
        margin-top: 1rem;
        padding-top: 0.65rem;
        border-top: 1px solid var(--line);
        font-size: 0.79rem;
        color: color-mix(in srgb, var(--ink) 64%, white 36%);
        display: grid;
        gap: 0.3rem;
      }

      .credit strong {
        font-weight: 600;
      }

      .floating-wa {
        position: fixed;
        right: 0.9rem;
        bottom: 0.9rem;
        width: 2.9rem;
        height: 2.9rem;
        border-radius: 3px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #25d366;
        color: #fff;
        box-shadow: 0 6px 16px rgba(18, 9, 10, 0.25);
      }

      .floating-wa svg {
        width: 1.28rem;
        height: 1.28rem;
      }

      @media (min-width: 900px) {
        .desktop-nav {
          display: inline-flex;
        }

        .mobile-actions {
          display: none;
        }

        .strip-grid {
          grid-template-columns: repeat(4, minmax(0, 1fr));
          grid-auto-flow: row;
          grid-auto-columns: auto;
          overflow: visible;
        }

        .menu-row {
          grid-template-columns: minmax(0, 4.5rem) minmax(0, 1.15fr) minmax(0, 2fr) auto;
          gap: 1rem;
          align-items: center;
        }

        .menu-row-head {
          display: block;
        }

        .gallery-strip {
          grid-template-columns: repeat(6, minmax(0, 1fr));
          grid-auto-flow: row;
          grid-auto-columns: auto;
          overflow: visible;
        }

        .footer-grid {
          grid-template-columns: 1.2fr 1fr 1fr 1fr;
          align-items: start;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#ana-sayfa" aria-label="Simay Sarıkaya ana bölüm">
          <strong>Simay Sarıkaya</strong>
          <span>Hair & Makeup Studio</span>
        </a>
        <nav class="desktop-nav" aria-label="Üst menü">
          <a href="#ana-sayfa">Ana Sayfa</a>
          <a href="#hizmetler">Hizmetler</a>
          <a href="#galeri">Galeri</a>
          <a href="#iletisim">İletişim</a>
          <a class="mini-wa" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52ZM12 21.88c-1.8 0-3.56-.48-5.1-1.4l-.37-.22-3.66.95.98-3.56-.24-.37A9.82 9.82 0 1 1 12 21.88Zm5.39-7.38c-.3-.15-1.76-.86-2.04-.95-.27-.1-.47-.15-.67.15-.2.3-.77.95-.95 1.14-.17.2-.35.22-.64.07-.3-.15-1.24-.46-2.36-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.45.13-.6.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.48.7.3 1.26.47 1.7.6.71.22 1.37.19 1.89.12.58-.08 1.76-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
            </svg>
          </a>
        </nav>
        <div class="mobile-actions">
          <a class="mini-wa" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52ZM12 21.88c-1.8 0-3.56-.48-5.1-1.4l-.37-.22-3.66.95.98-3.56-.24-.37A9.82 9.82 0 1 1 12 21.88Zm5.39-7.38c-.3-.15-1.76-.86-2.04-.95-.27-.1-.47-.15-.67.15-.2.3-.77.95-.95 1.14-.17.2-.35.22-.64.07-.3-.15-1.24-.46-2.36-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.45.13-.6.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.48.7.3 1.26.47 1.7.6.71.22 1.37.19 1.89.12.58-.08 1.76-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
            </svg>
          </a>
          <details class="mobile-menu">
            <summary class="mobile-icon" aria-label="Menü">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
              </svg>
            </summary>
            <nav class="mobile-menu-list" aria-label="Mobil menü">
              <a href="#ana-sayfa">Ana Sayfa</a>
              <a href="#hizmetler">Hizmetler</a>
              <a href="#galeri">Galeri</a>
              <a href="#iletisim">İletişim</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main>
      <section class="hero" id="ana-sayfa">
        <div class="hero-media">
          {
            <div class="hero-fallback" aria-hidden="true"></div>
          }
          <img
            src={heroImage}
            alt="Gelin saçı ve makyajı hazırlığı"
            loading="eager"
            onerror="this.style.display='none'"
          />
        </div>
        <div class="container hero-content">
          <div class="hero-copy">
            <p class="hero-eyebrow">Gaziosmanpaşa · Gelin Saçı ve Makyajı</p>
            <h1>Özel gününüz için saç ve makyajı zarif bir akışla planlayın.</h1>
            <p class="hero-desc">
              Gelin, kına, nişan ve davet hazırlıkları için hizmetleri inceleyin; randevu bilgisi için
              WhatsApp üzerinden iletişime geçin.
            </p>
            <div class="hero-cta">
              <a class="cta-btn primary" href={whatsappUrl} target="_blank" rel="noreferrer">
                WhatsApp’tan Randevu Bilgisi Al
              </a>
              <a class="cta-btn" href="#hizmetler">Hizmetleri İncele</a>
            </div>
          </div>
        </div>
      </section>

      <section class="service-strip">
        <div class="container strip-grid">
          {
            servicePanels.map((panel) => (
              <article
                class={`service-panel tone-${panel.tone}`}
                style={`--panel-image: url('${panel.image}');`}
              >
                <div class="service-caption">
                  <h2>{panel.title}</h2>
                  <p>{panel.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="menu-section" id="hizmetler">
        <div class="container menu-inner">
          <p class="menu-kicker">Hizmet Menüsü</p>
          <h2 class="menu-title">Etkinlik ritmine göre hazırlık akışları</h2>
          <div class="menu-list">
            {
              menuRows.map((row) => (
                <article class="menu-row">
                  <div class="menu-no">{row.no}</div>
                  <div class="menu-row-head">
                    <h3>{row.title}</h3>
                  </div>
                  <p>{row.description}</p>
                  <a class="row-cta" href={whatsappUrl} target="_blank" rel="noreferrer">
                    WhatsApp
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="gallery" id="galeri">
        <div class="container">
          <h2>Çalışmalardan seçili kareler</h2>
          <div class="gallery-strip">
            {
              galleryImages.map((src, index) => (
                <figure class="gallery-item">
                  <img
                    src={src}
                    alt={`Simay Sarıkaya hizmet görseli ${index + 1}`}
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section class="contact-strip" id="iletisim">
        <div class="container">
          <div class="contact-shell">
            <h2>Randevu ve iletişim</h2>
            <div class="contact-grid">
              <div class="contact-line">
                <span>Telefon</span>
                <a href={business.phoneHref}>{business.phone}</a>
              </div>
              <div class="contact-line">
                <span>WhatsApp</span>
                <a href={whatsappUrl} target="_blank" rel="noreferrer">
                  Mesaj Gönder
                </a>
              </div>
              <div class="contact-line">
                <span>Instagram</span>
                <a href={business.instagramUrl} target="_blank" rel="noreferrer">
                  @simaysarikayahairmakeup
                </a>
              </div>
              <div class="contact-line">
                <span>Konum</span>
                <strong>{business.district}</strong>
              </div>
              <div class="contact-line">
                <span>Harita</span>
                <a href={business.mapUrl} target="_blank" rel="noreferrer">
                  Google Maps / Yol Tarifi
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="compact-footer">
      <div class="container">
        <div class="footer-grid">
          <section class="footer-col">
            <h3>Marka</h3>
            <ul>
              <li>{business.name}</li>
              <li>Gaziosmanpaşa · İstanbul</li>
            </ul>
          </section>
          <section class="footer-col">
            <h3>Sayfalar</h3>
            <ul>
              <li><a href="#ana-sayfa">Ana Sayfa</a></li>
              <li><a href="#hizmetler">Hizmetler</a></li>
              <li><a href="#iletisim">Randevu & İletişim</a></li>
            </ul>
          </section>
          <section class="footer-col">
            <h3>Hizmetler</h3>
            <ul>
              <li>Gelin Saçı ve Makyajı</li>
              <li>Kına Hazırlığı</li>
              <li>Nişan Hazırlığı</li>
              <li>Davet Makyajı</li>
            </ul>
          </section>
          <section class="footer-col">
            <h3>İletişim</h3>
            <ul>
              <li><a href={business.phoneHref}>{business.phone}</a></li>
              <li><a href={whatsappUrl}>WhatsApp</a></li>
              <li><a href={business.instagramUrl}>Instagram</a></li>
              <li><a href={business.mapUrl}>Yol Tarifi</a></li>
            </ul>
          </section>
        </div>
        <div class="credit">
          <strong>Web tasarım ve bakım: aydemirs.com</strong>
          <span>
            Demo görseller temsili olarak kullanılmıştır. Yayın öncesi işletmenin kendi görselleriyle
            değiştirilebilir.
          </span>
        </div>
      </div>
    </footer>

    <a class="floating-wa" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp hızlı erişim">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52ZM12 21.88c-1.8 0-3.56-.48-5.1-1.4l-.37-.22-3.66.95.98-3.56-.24-.37A9.82 9.82 0 1 1 12 21.88Zm5.39-7.38c-.3-.15-1.76-.86-2.04-.95-.27-.1-.47-.15-.67.15-.2.3-.77.95-.95 1.14-.17.2-.35.22-.64.07-.3-.15-1.24-.46-2.36-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.45.13-.6.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.48.7.3 1.26.47 1.7.6.71.22 1.37.19 1.89.12.58-.08 1.76-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
      </svg>
    </a>
  </body>
</html>
