---
import "../../../styles/simay-cinematic.css";

const routes = {
  home: "/style-lab/simay-cinematic/",
  services: "/style-lab/simay-cinematic/hizmetler/",
  contact: "/style-lab/simay-cinematic/randevu/",
};

const whatsappMessage = encodeURIComponent(
  "Merhaba, hizmetleriniz ve randevu bilgisi hakkında bilgi almak istiyorum.",
);
const whatsappUrl = `https://wa.me/905337774545?text=${whatsappMessage}`;
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Simay Sarıkaya | Sinematik Randevu</title>
    <meta name="description" content="Sinematik tasarım yönünde Simay Sarıkaya randevu ve iletişim sayfası." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://example.com/style-lab/simay-cinematic/randevu/" />
  </head>
  <body>
    <div class="sc-wrap">
      <header class="sc-header">
        <div class="sc-box sc-head-row">
          <a class="sc-brand" href={routes.home}><strong>Simay Sarıkaya</strong><span>Gelin Saçı ve Makyajı</span></a>
          <nav class="sc-nav-d"><a href={routes.home}>Ana Sayfa</a><a href={routes.services}>Hizmetler</a><a href={routes.contact}>Randevu & İletişim</a><a class="sc-ico" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a></nav>
          <div class="sc-nav-m">
            <a class="sc-ico" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a>
            <details class="sc-menu-wrap"><summary class="sc-menu-btn" aria-label="Menü"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg></summary><nav class="sc-menu-pane"><a href={routes.home}>Ana Sayfa</a><a href={routes.services}>Hizmetler</a><a href={routes.contact}>Randevu & İletişim</a></nav></details>
          </div>
        </div>
      </header>

      <main class="sc-band">
        <div class="sc-box">
          <section class="sc-contact-hero">
            <img src="/assets/businesses/simay-sarikaya/hero-bridal-01.jpg" alt="Randevu görseli" onerror="this.style.display='none'" />
            <div class="sc-svc-hero-copy">
              <p class="sc-kicker">Randevu ve İletişim</p>
              <h1 class="sc-title" style="font-size:clamp(1.7rem,4vw,3rem)">Randevu & İletişim</h1>
              <p class="sc-lead">Simay Sarıkaya, Gaziosmanpaşa’da gelin, kına, nişan ve davet hazırlıkları için saç ve makyaj hizmetleri sunan özel gün odaklı bir stüdyodur.</p>
            </div>
          </section>

          <section class="sc-band sc-contact-grid">
            <article class="sc-panel">
              <h2 class="sc-title" style="font-size:clamp(1.2rem,2.8vw,1.8rem)">İletişim bilgileri</h2>
              <div class="sc-line"><span>Telefon</span><a href="tel:+902126104545">+90 212 610 45 45</a></div>
              <div class="sc-line"><span>WhatsApp</span><a href={whatsappUrl}>Mesaj Gönder</a></div>
              <div class="sc-line"><span>Instagram</span><a href="https://instagram.com/simaysarikayahairmakeup">@simaysarikayahairmakeup</a></div>
              <div class="sc-line"><span>Konum</span><strong>Merkez Mahallesi, Gaziosmanpaşa</strong></div>
            </article>

            <article class="sc-panel">
              <h2 class="sc-title" style="font-size:clamp(1.2rem,2.8vw,1.8rem)">Yol tarifi</h2>
              <div class="sc-map"></div>
              <div class="sc-actions" style="margin-top:0.7rem">
                <a class="sc-btn sc-btn-main" href="https://maps.google.com/?q=Gaziosmanpasa+Istanbul" target="_blank" rel="noreferrer">
                  Google Maps / Yol Tarifi
                </a>
              </div>
            </article>
          </section>

          <section class="sc-cta sc-band">
            <div class="sc-box sc-cta-row">
              <div>
                <p class="sc-kicker">Randevu Bilgisi</p>
                <h2 class="sc-title" style="font-size:clamp(1.3rem,3.1vw,2.15rem)">Hazırlık akışını birlikte planlayalım</h2>
                <p class="sc-lead">Randevu ve hizmet detayları için WhatsApp üzerinden iletişime geçebilirsiniz.</p>
              </div>
              <div class="sc-actions">
                <a class="sc-btn sc-btn-main" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp’tan Randevu Bilgisi Al</a>
                <a class="sc-btn" href={routes.services}>Hizmetleri İncele</a>
              </div>
            </div>
          </section>
        </div>
      </main>

      <footer class="sc-foot">
        <div class="sc-box">
          <div class="sc-foot-grid">
            <section class="sc-foot"><h3>Marka</h3><ul><li>Simay Sarıkaya</li><li>Gelin Saçı ve Makyajı</li><li>Gaziosmanpaşa · İstanbul</li></ul></section>
            <section class="sc-foot"><h3>Sayfalar</h3><ul><li><a href={routes.home}>Ana Sayfa</a></li><li><a href={routes.services}>Hizmetler</a></li><li><a href={routes.contact}>Randevu & İletişim</a></li></ul></section>
            <section class="sc-foot"><h3>Hizmetler</h3><ul><li>Gelin Saçı ve Makyajı</li><li>Kına Hazırlığı</li><li>Nişan Hazırlığı</li><li>Davet Makyajı</li><li>Özel Gün Saç Tasarımı</li></ul></section>
            <section class="sc-foot"><h3>İletişim</h3><ul><li><a href="tel:+902126104545">+90 212 610 45 45</a></li><li><a href={whatsappUrl}>WhatsApp</a></li><li><a href="https://instagram.com/simaysarikayahairmakeup">Instagram</a></li><li><a href="https://maps.google.com/?q=Gaziosmanpasa+Istanbul">Yol Tarifi</a></li></ul></section>
          </div>
          <div class="sc-credit"><strong>Web tasarım ve bakım: aydemirs.com</strong><span>Demo görseller temsili olarak kullanılmıştır. Yayın öncesi işletmenin kendi görselleriyle değiştirilebilir.</span></div>
        </div>
      </footer>

      <a class="sc-float" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp hızlı erişim"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a>
    </div>
  </body>
</html>
