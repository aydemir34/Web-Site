---
import "../../../styles/simay-cinematic.css";

const routes = {
  home: "/style-lab/simay-cinematic/",
  services: "/style-lab/simay-cinematic/hizmetler/",
  contact: "/style-lab/simay-cinematic/randevu/",
};

const whatsappMessage = encodeURIComponent(
  "Merhaba, hizmetleriniz ve randevu bilgisi hakkında bilgi almak istiyorum.",
);
const whatsappUrl = `https://wa.me/905337774545?text=${whatsappMessage}`;

const servicePanels = [
  {
    title: "Gelin Saçı ve Makyajı",
    text: "Prova ve düğün günü hazırlığı birlikte planlanır.",
    image: "/assets/businesses/simay-sarikaya/service-makeup-01.jpg",
  },
  {
    title: "Kına Hazırlığı",
    text: "Kıyafet tonu ve gece akışına uygun görünüm oluşturulur.",
    image: "/assets/businesses/simay-sarikaya/service-hair-01.jpg",
  },
  {
    title: "Nişan Hazırlığı",
    text: "Fotoğrafa hazır ve dengeli bir saç-makyaj çizgisi kurulur.",
    image: "/assets/businesses/simay-sarikaya/grid-02.jpg",
  },
  {
    title: "Davet Makyajı",
    text: "Etkinliğin temposuna göre sade ya da belirgin seçenek sunulur.",
    image: "/assets/businesses/simay-sarikaya/grid-03.jpg",
  },
];

const gallery = [
  "/assets/businesses/simay-sarikaya/grid-01.jpg",
  "/assets/businesses/simay-sarikaya/grid-02.jpg",
  "/assets/businesses/simay-sarikaya/grid-03.jpg",
  "/assets/businesses/simay-sarikaya/pexels-kerimeveyik-22589552.jpg",
  "/assets/businesses/simay-sarikaya/service-makeup-01.jpg",
  "/assets/businesses/simay-sarikaya/service-hair-01.jpg",
];
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Simay Sarıkaya | Sinematik Güzellik</title>
    <meta
      name="description"
      content="Simay Sarıkaya için sinematik güzellik yönünde hazırlanmış üç sayfalık style-lab ana sayfa."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://example.com/style-lab/simay-cinematic/" />
  </head>
  <body>
    <div class="sc-wrap">
      <header class="sc-header">
        <div class="sc-box sc-head-row">
          <a class="sc-brand" href={routes.home}>
            <strong>Simay Sarıkaya</strong>
            <span>Gelin Saçı ve Makyajı</span>
          </a>
          <nav class="sc-nav-d" aria-label="Üst menü">
            <a href={routes.home}>Ana Sayfa</a>
            <a href={routes.services}>Hizmetler</a>
            <a href={routes.contact}>Randevu & İletişim</a>
            <a class="sc-ico" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" />
              </svg>
            </a>
          </nav>
          <div class="sc-nav-m">
            <a class="sc-ico" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" />
              </svg>
            </a>
            <details class="sc-menu-wrap">
              <summary class="sc-menu-btn" aria-label="Menü">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                </svg>
              </summary>
              <nav class="sc-menu-pane" aria-label="Mobil menü">
                <a href={routes.home}>Ana Sayfa</a>
                <a href={routes.services}>Hizmetler</a>
                <a href={routes.contact}>Randevu & İletişim</a>
              </nav>
            </details>
          </div>
        </div>
      </header>

      <main>
        <section class="sc-hero">
          <div class="sc-hero-media">
            <img
              src="/assets/businesses/simay-sarikaya/hero-bridal-01.jpg"
              alt="Gelin saçı ve makyajı hazırlığı"
              loading="eager"
              onerror="this.style.display='none'"
            />
          </div>
          <div class="sc-box sc-hero-content">
            <div class="sc-glass">
              <p class="sc-kicker">Gaziosmanpaşa · Gelin Saçı ve Makyajı</p>
              <h1 class="sc-title">Özel gününüz için saç ve makyajı zarif bir akışla planlayın.</h1>
              <p class="sc-lead">
                Gelin, kına, nişan ve davet hazırlıkları için hizmetleri inceleyin; randevu bilgisi için
                WhatsApp üzerinden iletişime geçin.
              </p>
              <div class="sc-actions">
                <a class="sc-btn sc-btn-main" href={whatsappUrl} target="_blank" rel="noreferrer">
                  WhatsApp’tan Randevu Bilgisi Al
                </a>
                <a class="sc-btn" href={routes.services}>Hizmetleri İncele</a>
              </div>
            </div>
          </div>
        </section>

        <section class="sc-band">
          <div class="sc-box sc-panels">
            {
              servicePanels.map((item) => (
                <article class="sc-pane">
                  <img src={item.image} alt={item.title} loading="lazy" onerror="this.style.display='none'" />
                  <div class="sc-caption">
                    <h2>{item.title}</h2>
                    <p>{item.text}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="sc-band">
          <div class="sc-box">
            <p class="sc-kicker">Seçili Kareler</p>
            <h2 class="sc-title" style="font-size:clamp(1.4rem,3vw,2.2rem)">Hazırlık sürecinden görsel ritim</h2>
            <div class="sc-gallery">
              {
                gallery.map((src, i) => (
                  <figure class="sc-shot">
                    <img src={src} alt={`Simay Sarıkaya görseli ${i + 1}`} loading="lazy" onerror="this.style.display='none'" />
                  </figure>
                ))
              }
            </div>
          </div>
        </section>

        <section class="sc-cta sc-band">
          <div class="sc-box sc-cta-row">
            <div>
              <p class="sc-kicker">Randevu Bilgisi</p>
              <h2 class="sc-title" style="font-size:clamp(1.4rem,3.2vw,2.3rem)">Takviminizi birlikte netleştirelim</h2>
              <p class="sc-lead">Etkinlik tarihinizi paylaşın, prova ve hazırlık adımlarını aynı gün içinde planlayalım.</p>
            </div>
            <div class="sc-actions">
              <a class="sc-btn sc-btn-main" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp’tan Yaz</a>
              <a class="sc-btn" href={routes.contact}>Randevu & İletişim</a>
            </div>
          </div>
        </section>
      </main>

      <footer class="sc-foot">
        <div class="sc-box">
          <div class="sc-foot-grid">
            <section class="sc-foot">
              <h3>Marka</h3>
              <ul>
                <li>Simay Sarıkaya</li>
                <li>Gelin Saçı ve Makyajı</li>
                <li>Gaziosmanpaşa · İstanbul</li>
              </ul>
            </section>
            <section class="sc-foot">
              <h3>Sayfalar</h3>
              <ul>
                <li><a href={routes.home}>Ana Sayfa</a></li>
                <li><a href={routes.services}>Hizmetler</a></li>
                <li><a href={routes.contact}>Randevu & İletişim</a></li>
              </ul>
            </section>
            <section class="sc-foot">
              <h3>Hizmetler</h3>
              <ul>
                <li>Gelin Saçı ve Makyajı</li>
                <li>Kına Hazırlığı</li>
                <li>Nişan Hazırlığı</li>
                <li>Davet Makyajı</li>
              </ul>
            </section>
            <section class="sc-foot">
              <h3>İletişim</h3>
              <ul>
                <li><a href="tel:+902126104545">+90 212 610 45 45</a></li>
                <li><a href={whatsappUrl}>WhatsApp</a></li>
                <li><a href="https://instagram.com/simaysarikayahairmakeup">Instagram</a></li>
                <li><a href="https://maps.google.com/?q=Gaziosmanpasa+Istanbul">Yol Tarifi</a></li>
              </ul>
            </section>
          </div>
          <div class="sc-credit">
            <strong>Web tasarım ve bakım: aydemirs.com</strong>
            <span>Demo görseller temsili olarak kullanılmıştır. Yayın öncesi işletmenin kendi görselleriyle değiştirilebilir.</span>
          </div>
        </div>
      </footer>

      <a class="sc-float" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp hızlı erişim">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" />
        </svg>
      </a>
    </div>
  </body>
</html>
