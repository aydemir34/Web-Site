---
import "../../../styles/simay-cinematic.css";

const routes = {
  home: "/style-lab/simay-cinematic/",
  services: "/style-lab/simay-cinematic/hizmetler/",
  contact: "/style-lab/simay-cinematic/randevu/",
};

const whatsappMessage = encodeURIComponent(
  "Merhaba, hizmetleriniz ve randevu bilgisi hakkında bilgi almak istiyorum.",
);
const whatsappUrl = `https://wa.me/905337774545?text=${whatsappMessage}`;

const services = [
  {
    no: "01",
    title: "Gelin Saçı ve Makyajı",
    desc: "Düğün konsepti, gelinlik ve çekim planına göre saç ve makyaj hazırlığı planlanır.",
    image: "/assets/businesses/simay-sarikaya/service-makeup-01.jpg",
  },
  {
    no: "02",
    title: "Kına Hazırlığı",
    desc: "Kına gecesi konsepti, kıyafet ve sahne ışığına uyumlu görünüm oluşturulur.",
    image: "/assets/businesses/simay-sarikaya/service-hair-01.jpg",
  },
  {
    no: "03",
    title: "Nişan Hazırlığı",
    desc: "Nişan günü için daha zarif, fotoğrafa hazır ve dengeli bir saç-makyaj akışı hazırlanır.",
    image: "/assets/businesses/simay-sarikaya/grid-02.jpg",
  },
  {
    no: "04",
    title: "Davet Makyajı",
    desc: "Özel davetler, doğum günü ve etkinlikler için sade ya da belirgin makyaj seçenekleri sunulur.",
    image: "/assets/businesses/simay-sarikaya/grid-03.jpg",
  },
  {
    no: "05",
    title: "Özel Gün Saç Tasarımı",
    desc: "Topuz, dalga, fön ve konsept saç tasarımı gibi özel gün hazırlıkları planlanır.",
    image: "/assets/businesses/simay-sarikaya/pexels-kerimeveyik-22589552.jpg",
  },
];
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Simay Sarıkaya | Sinematik Hizmetler</title>
    <meta name="description" content="Sinematik tasarım yönünde Simay Sarıkaya hizmetler sayfası." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://example.com/style-lab/simay-cinematic/hizmetler/" />
  </head>
  <body>
    <div class="sc-wrap">
      <header class="sc-header">
        <div class="sc-box sc-head-row">
          <a class="sc-brand" href={routes.home}>
            <strong>Simay Sarıkaya</strong>
            <span>Gelin Saçı ve Makyajı</span>
          </a>
          <nav class="sc-nav-d" aria-label="Üst menü">
            <a href={routes.home}>Ana Sayfa</a>
            <a href={routes.services}>Hizmetler</a>
            <a href={routes.contact}>Randevu & İletişim</a>
            <a class="sc-ico" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg>
            </a>
          </nav>
          <div class="sc-nav-m">
            <a class="sc-ico" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg>
            </a>
            <details class="sc-menu-wrap">
              <summary class="sc-menu-btn" aria-label="Menü">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
              </summary>
              <nav class="sc-menu-pane">
                <a href={routes.home}>Ana Sayfa</a>
                <a href={routes.services}>Hizmetler</a>
                <a href={routes.contact}>Randevu & İletişim</a>
              </nav>
            </details>
          </div>
        </div>
      </header>

      <main class="sc-band">
        <div class="sc-box">
          <section class="sc-svc-hero">
            <img src="/assets/businesses/simay-sarikaya/hero-bridal-01.jpg" alt="Hizmet görseli" onerror="this.style.display='none'" />
            <div class="sc-svc-hero-copy">
              <p class="sc-kicker">Hizmetler</p>
              <h1 class="sc-title" style="font-size:clamp(1.7rem,4vw,3rem)">Hizmetler</h1>
              <p class="sc-lead">Gelin, kına, nişan ve davet hazırlıkları için saç ve makyaj hizmetlerini tek sayfada inceleyin.</p>
            </div>
          </section>

          {
            services.map((s) => (
              <section class="sc-film">
                <article class="sc-film-block">
                  <img src={s.image} alt={s.title} loading="lazy" onerror="this.style.display='none'" />
                  <div class="sc-film-copy">
                    <p class="sc-film-num">{s.no}</p>
                    <h2>{s.title}</h2>
                    <p>{s.desc}</p>
                    <div class="sc-actions">
                      <a class="sc-btn sc-btn-main" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp’tan Randevu Bilgisi Al</a>
                    </div>
                  </div>
                </article>
              </section>
            ))
          }

          <section class="sc-cta sc-band" style="margin-top:1rem">
            <div class="sc-box sc-cta-row">
              <div>
                <p class="sc-kicker">Randevu Adımı</p>
                <h2 class="sc-title" style="font-size:clamp(1.3rem,3.2vw,2.2rem)">Takviminizi birlikte netleştirelim</h2>
              </div>
              <div class="sc-actions">
                <a class="sc-btn sc-btn-main" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp’tan Yaz</a>
                <a class="sc-btn" href={routes.contact}>Randevu & İletişim</a>
              </div>
            </div>
          </section>
        </div>
      </main>

      <footer class="sc-foot">
        <div class="sc-box">
          <div class="sc-foot-grid">
            <section class="sc-foot"><h3>Marka</h3><ul><li>Simay Sarıkaya</li><li>Gaziosmanpaşa · İstanbul</li></ul></section>
            <section class="sc-foot"><h3>Sayfalar</h3><ul><li><a href={routes.home}>Ana Sayfa</a></li><li><a href={routes.services}>Hizmetler</a></li><li><a href={routes.contact}>Randevu & İletişim</a></li></ul></section>
            <section class="sc-foot"><h3>Hizmetler</h3><ul><li>Gelin Saçı ve Makyajı</li><li>Kına Hazırlığı</li><li>Nişan Hazırlığı</li><li>Davet Makyajı</li></ul></section>
            <section class="sc-foot"><h3>İletişim</h3><ul><li><a href="tel:+902126104545">+90 212 610 45 45</a></li><li><a href={whatsappUrl}>WhatsApp</a></li><li><a href="https://instagram.com/simaysarikayahairmakeup">Instagram</a></li><li><a href="https://maps.google.com/?q=Gaziosmanpasa+Istanbul">Yol Tarifi</a></li></ul></section>
          </div>
          <div class="sc-credit"><strong>Web tasarım ve bakım: aydemirs.com</strong><span>Demo görseller temsili olarak kullanılmıştır. Yayın öncesi işletmenin kendi görselleriyle değiştirilebilir.</span></div>
        </div>
      </footer>

      <a class="sc-float" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp hızlı erişim">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg>
      </a>
    </div>
  </body>
</html>
