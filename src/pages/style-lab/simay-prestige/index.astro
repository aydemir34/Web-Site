---
import "../../../styles/salon-prestige.css";

const routes = {
  home: "/style-lab/simay-prestige/",
  services: "/style-lab/simay-prestige/hizmetler/",
  contact: "/style-lab/simay-prestige/randevu/",
};

const whatsappMessage = encodeURIComponent(
  "Merhaba, hizmetleriniz ve randevu bilgisi hakkında bilgi almak istiyorum.",
);
const whatsappUrl = `https://wa.me/905337774545?text=${whatsappMessage}`;

const servicePanels = [
  {
    title: "Gelin Saçı ve Makyajı",
    text: "Prova süreci ve düğün günü hazırlığı tek akışta planlanır.",
    image: "/assets/businesses/simay-sarikaya/service-makeup-01.jpg",
  },
  {
    title: "Kına Hazırlığı",
    text: "Kına konsepti ve kıyafet tonuna uygun görünüm kurgulanır.",
    image: "/assets/businesses/simay-sarikaya/service-hair-01.jpg",
  },
  {
    title: "Nişan Hazırlığı",
    text: "Fotoğrafa hazır, dengeli ve zarif bir saç-makyaj akışı oluşturulur.",
    image: "/assets/businesses/simay-sarikaya/grid-02.jpg",
  },
  {
    title: "Davet Makyajı",
    text: "Özel davetler için sade ya da belirgin makyaj alternatifleri sunulur.",
    image: "/assets/businesses/simay-sarikaya/grid-03.jpg",
  },
];

const gallery = [
  "/assets/businesses/simay-sarikaya/grid-01.jpg",
  "/assets/businesses/simay-sarikaya/grid-02.jpg",
  "/assets/businesses/simay-sarikaya/grid-03.jpg",
  "/assets/businesses/simay-sarikaya/pexels-kerimeveyik-22589552.jpg",
  "/assets/businesses/simay-sarikaya/service-makeup-01.jpg",
  "/assets/businesses/simay-sarikaya/service-hair-01.jpg",
];
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Simay Sarıkaya | Ana Sayfa</title>
    <meta
      name="description"
      content="Simay Sarıkaya için saç ve makyaj odaklı prestij tasarım laboratuvarı ana sayfa denemesi."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://example.com/style-lab/simay-prestige/" />
  </head>
  <body>
    <div class="sp-page">
      <header class="sp-header">
        <div class="sp-container sp-header-inner">
          <a class="sp-brand" href={routes.home}>
            <strong>Simay Sarıkaya</strong>
            <span>Gelin Saçı ve Makyajı</span>
          </a>
          <nav class="sp-nav-desktop" aria-label="Üst menü">
            <a href={routes.home}>Ana Sayfa</a>
            <a href={routes.services}>Hizmetler</a>
            <a href={routes.contact}>Randevu & İletişim</a>
            <a class="sp-icon-link" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52ZM12 21.88c-1.8 0-3.56-.48-5.1-1.4l-.37-.22-3.66.95.98-3.56-.24-.37A9.82 9.82 0 1 1 12 21.88Zm5.39-7.38c-.3-.15-1.76-.86-2.04-.95-.27-.1-.47-.15-.67.15-.2.3-.77.95-.95 1.14-.17.2-.35.22-.64.07-.3-.15-1.24-.46-2.36-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.45.13-.6.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.48.7.3 1.26.47 1.7.6.71.22 1.37.19 1.89.12.58-.08 1.76-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
              </svg>
            </a>
          </nav>
          <div class="sp-nav-mobile">
            <a class="sp-icon-link" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52ZM12 21.88c-1.8 0-3.56-.48-5.1-1.4l-.37-.22-3.66.95.98-3.56-.24-.37A9.82 9.82 0 1 1 12 21.88Zm5.39-7.38c-.3-.15-1.76-.86-2.04-.95-.27-.1-.47-.15-.67.15-.2.3-.77.95-.95 1.14-.17.2-.35.22-.64.07-.3-.15-1.24-.46-2.36-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.45.13-.6.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.48.7.3 1.26.47 1.7.6.71.22 1.37.19 1.89.12.58-.08 1.76-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
              </svg>
            </a>
            <details class="sp-mobile-menu">
              <summary class="sp-menu-trigger" aria-label="Menü">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                </svg>
              </summary>
              <nav class="sp-mobile-panel" aria-label="Mobil menü">
                <a href={routes.home}>Ana Sayfa</a>
                <a href={routes.services}>Hizmetler</a>
                <a href={routes.contact}>Randevu & İletişim</a>
              </nav>
            </details>
          </div>
        </div>
      </header>

      <main>
        <section class="sp-home-hero">
          <div class="sp-media-frame">
            <img
              src="/assets/businesses/simay-sarikaya/hero-bridal-01.jpg"
              alt="Gelin saçı ve makyajı hazırlığı"
              loading="eager"
              onerror="this.style.display='none'"
            />
          </div>
          <div class="sp-container sp-home-hero-inner">
            <div class="sp-home-hero-copy">
              <p class="sp-kicker">Gaziosmanpaşa · Gelin Saçı ve Makyajı</p>
              <h1 class="sp-title">Özel gününüz için saç ve makyajı zarif bir akışla planlayın.</h1>
              <p class="sp-lead">
                Gelin, kına, nişan ve davet hazırlıkları için hizmetleri inceleyin; randevu bilgisi için
                WhatsApp üzerinden iletişime geçin.
              </p>
              <div class="sp-btn-row">
                <a class="sp-btn sp-btn-primary" href={whatsappUrl} target="_blank" rel="noreferrer">
                  WhatsApp’tan Randevu Bilgisi Al
                </a>
                <a class="sp-btn sp-btn-light" href={routes.services}>Hizmetleri İncele</a>
              </div>
            </div>
          </div>
        </section>

        <section class="sp-service-strip">
          <div class="sp-container sp-service-grid">
            {
              servicePanels.map((item) => (
                <article class="sp-service-panel">
                  <div class="sp-media-frame">
                    <img src={item.image} alt={item.title} loading="lazy" onerror="this.style.display='none'" />
                  </div>
                  <div class="sp-panel-overlay">
                    <h2>{item.title}</h2>
                    <p>{item.text}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="sp-why sp-section">
          <div class="sp-container">
            <p class="sp-kicker">Neden Simay Sarıkaya</p>
            <h2 class="sp-title">Özel gün hazırlığında net ve zarif planlama</h2>
            <div class="sp-why-list">
              <article class="sp-why-item">
                <strong>Konsepte Uyumlu Akış</strong>
                <p>Gelinlik, aksesuar ve etkinlik temposuna göre saç ve makyaj dili birlikte planlanır.</p>
              </article>
              <article class="sp-why-item">
                <strong>Prova Gününde Netleştirme</strong>
                <p>Prova aşamasında görünüm kararı netleştirilir, düğün günü sürpriz bırakılmaz.</p>
              </article>
              <article class="sp-why-item">
                <strong>Fotoğrafa Hazır Denge</strong>
                <p>Işık, ten tonu ve çekim yoğunluğuna uygun ürünlerle görünüm gün boyu korunur.</p>
              </article>
              <article class="sp-why-item">
                <strong>WhatsApp Üzerinden Hızlı İletişim</strong>
                <p>Tarih ve hizmet detayları kısa sürede paylaşılır, randevu bilgisi hızlıca netleşir.</p>
              </article>
            </div>
          </div>
        </section>

        <section class="sp-section">
          <div class="sp-container">
            <p class="sp-kicker">Seçili Çalışmalar</p>
            <h2 class="sp-title">Hazırlık sürecinden kareler</h2>
            <div class="sp-gallery-grid">
              {
                gallery.map((src, i) => (
                  <figure class="sp-gallery-item">
                    <div class="sp-media-frame">
                      <img src={src} alt={`Simay Sarıkaya görseli ${i + 1}`} loading="lazy" onerror="this.style.display='none'" />
                    </div>
                  </figure>
                ))
              }
            </div>
          </div>
        </section>

        <section class="sp-cta-band sp-section">
          <div class="sp-container sp-cta-inner">
            <div>
              <p class="sp-kicker">Randevu Bilgisi</p>
              <h2 class="sp-title">Takviminizi bu hafta netleştirelim</h2>
              <p class="sp-lead">
                Etkinlik tarihinizi ve istediğiniz görünümü paylaşın; uygun prova ve hazırlık planı için size hızlıca dönüş sağlayalım.
              </p>
            </div>
            <div class="sp-btn-row">
              <a class="sp-btn sp-btn-primary" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp’tan Yaz</a>
              <a class="sp-btn sp-btn-light" href={routes.contact}>Randevu & İletişim</a>
            </div>
          </div>
        </section>
      </main>

      <footer class="sp-footer">
        <div class="sp-container">
          <div class="sp-footer-grid">
            <section class="sp-footer-col">
              <h3>Marka</h3>
              <ul>
                <li>Simay Sarıkaya</li>
                <li>Gelin Saçı ve Makyajı</li>
                <li>Gaziosmanpaşa · İstanbul</li>
              </ul>
            </section>
            <section class="sp-footer-col">
              <h3>Sayfalar</h3>
              <ul>
                <li><a href={routes.home}>Ana Sayfa</a></li>
                <li><a href={routes.services}>Hizmetler</a></li>
                <li><a href={routes.contact}>Randevu & İletişim</a></li>
              </ul>
            </section>
            <section class="sp-footer-col">
              <h3>Hizmetler</h3>
              <ul>
                <li>Gelin Saçı ve Makyajı</li>
                <li>Kına Hazırlığı</li>
                <li>Nişan Hazırlığı</li>
                <li>Davet Makyajı</li>
              </ul>
            </section>
            <section class="sp-footer-col">
              <h3>İletişim</h3>
              <ul>
                <li><a href="tel:+902126104545">+90 212 610 45 45</a></li>
                <li><a href={whatsappUrl}>WhatsApp</a></li>
                <li><a href="https://instagram.com/simaysarikayahairmakeup">Instagram</a></li>
                <li><a href="https://maps.google.com/?q=Gaziosmanpasa+Istanbul">Yol Tarifi</a></li>
              </ul>
            </section>
          </div>
          <div class="sp-footer-credit">
            <strong>Web tasarım ve bakım: aydemirs.com</strong>
            <span>Demo görseller temsili olarak kullanılmıştır. Yayın öncesi işletmenin kendi görselleriyle değiştirilebilir.</span>
          </div>
        </div>
      </footer>

      <a class="sp-floating-wa" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp hızlı erişim">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52ZM12 21.88c-1.8 0-3.56-.48-5.1-1.4l-.37-.22-3.66.95.98-3.56-.24-.37A9.82 9.82 0 1 1 12 21.88Zm5.39-7.38c-.3-.15-1.76-.86-2.04-.95-.27-.1-.47-.15-.67.15-.2.3-.77.95-.95 1.14-.17.2-.35.22-.64.07-.3-.15-1.24-.46-2.36-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.45.13-.6.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.48.7.3 1.26.47 1.7.6.71.22 1.37.19 1.89.12.58-.08 1.76-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
        </svg>
      </a>
    </div>
  </body>
</html>
