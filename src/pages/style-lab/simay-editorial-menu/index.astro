---
import "../../../styles/simay-editorial-menu.css";

const routes = {
  home: "/style-lab/simay-editorial-menu/",
  services: "/style-lab/simay-editorial-menu/hizmetler/",
  contact: "/style-lab/simay-editorial-menu/randevu/",
};

const whatsappMessage = encodeURIComponent(
  "Merhaba, hizmetleriniz ve randevu bilgisi hakkında bilgi almak istiyorum.",
);
const whatsappUrl = `https://wa.me/905337774545?text=${whatsappMessage}`;

const menuRows = [
  ["01", "Gelin Saçı ve Makyajı", "Prova ve düğün günü hazırlığı tek akışta netleştirilir."],
  ["02", "Kına Hazırlığı", "Kına gecesi konseptine uyumlu güçlü bir görünüm hazırlanır."],
  ["03", "Nişan Hazırlığı", "Nişan gününde zarif, dengeli ve fotoğrafa hazır çizgi korunur."],
  ["04", "Davet Makyajı", "Etkinliğin stiline göre sade veya belirgin makyaj uygulanır."],
];
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Simay Sarıkaya | Editoryal Menü</title>
    <meta name="description" content="Simay Sarıkaya için editoryal servis menüsü yönünde tasarım denemesi." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://example.com/style-lab/simay-editorial-menu/" />
  </head>
  <body>
    <div class="se-root">
      <header class="se-top">
        <div class="se-wrap se-top-row">
          <a class="se-logo" href={routes.home}><strong>Simay Sarıkaya</strong><span>Gelin Saçı ve Makyajı</span></a>
          <nav class="se-nav-d" aria-label="Üst menü">
            <a href={routes.home}>Ana Sayfa</a>
            <a href={routes.services}>Hizmetler</a>
            <a href={routes.contact}>Randevu & İletişim</a>
            <a class="se-icon" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg>
            </a>
          </nav>
          <div class="se-nav-m">
            <a class="se-icon" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a>
            <details class="se-menu"><summary class="se-menu-btn" aria-label="Menü"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg></summary><nav class="se-menu-box"><a href={routes.home}>Ana Sayfa</a><a href={routes.services}>Hizmetler</a><a href={routes.contact}>Randevu & İletişim</a></nav></details>
          </div>
        </div>
      </header>

      <main class="se-main">
        <div class="se-wrap">
          <section class="se-hero">
            <div class="se-copy">
              <p class="se-kicker">Gaziosmanpaşa · Gelin Saçı ve Makyajı</p>
              <h1>Özel gününüz için saç ve makyajı zarif bir akışla planlayın.</h1>
              <p>Gelin, kına, nişan ve davet hazırlıkları için hizmetleri inceleyin; randevu bilgisi için WhatsApp üzerinden iletişime geçin.</p>
              <div class="se-actions">
                <a class="se-btn se-btn-main" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp’tan Randevu Bilgisi Al</a>
                <a class="se-btn" href={routes.services}>Hizmetleri İncele</a>
              </div>
            </div>
            <figure class="se-hero-frame">
              <img src="/assets/businesses/simay-sarikaya/hero-bridal-01.jpg" alt="Hazırlık süreci" onerror="this.style.display='none'" />
            </figure>
          </section>

          <section class="se-menu-grid">
            <div class="se-menu-list">
              {
                menuRows.map(([no, title, desc]) => (
                  <article class="se-row">
                    <div class="se-row-h">
                      <span class="se-no">{no}</span>
                      <h2>{title}</h2>
                    </div>
                    <p>{desc}</p>
                  </article>
                ))
              }
            </div>
            <aside class="se-side-media">
              <img src="/assets/businesses/simay-sarikaya/service-hair-01.jpg" alt="Hizmet görünümü" onerror="this.style.display='none'" />
            </aside>
          </section>
        </div>
      </main>

      <footer class="se-footer">
        <div class="se-wrap">
          <div class="se-foot-grid">
            <section><h3>Marka</h3><ul><li>Simay Sarıkaya</li><li>Gelin Saçı ve Makyajı</li><li>Gaziosmanpaşa · İstanbul</li></ul></section>
            <section><h3>Sayfalar</h3><ul><li><a href={routes.home}>Ana Sayfa</a></li><li><a href={routes.services}>Hizmetler</a></li><li><a href={routes.contact}>Randevu & İletişim</a></li></ul></section>
            <section><h3>Hizmetler</h3><ul><li>Gelin Saçı ve Makyajı</li><li>Kına Hazırlığı</li><li>Nişan Hazırlığı</li><li>Davet Makyajı</li></ul></section>
            <section><h3>İletişim</h3><ul><li><a href="tel:+902126104545">+90 212 610 45 45</a></li><li><a href={whatsappUrl}>WhatsApp</a></li><li><a href="https://instagram.com/simaysarikayahairmakeup">Instagram</a></li><li><a href="https://maps.google.com/?q=Gaziosmanpasa+Istanbul">Yol Tarifi</a></li></ul></section>
          </div>
          <div class="se-credit"><strong>Web tasarım ve bakım: aydemirs.com</strong><span>Demo görseller temsili olarak kullanılmıştır. Yayın öncesi işletmenin kendi görselleriyle değiştirilebilir.</span></div>
        </div>
      </footer>

      <a class="se-float" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp hızlı erişim"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a>
    </div>
  </body>
</html>
