---
import "../../../styles/simay-editorial-menu.css";

const routes = {
  home: "/style-lab/simay-editorial-menu/",
  services: "/style-lab/simay-editorial-menu/hizmetler/",
  contact: "/style-lab/simay-editorial-menu/randevu/",
};

const whatsappMessage = encodeURIComponent(
  "Merhaba, hizmetleriniz ve randevu bilgisi hakkında bilgi almak istiyorum.",
);
const whatsappUrl = `https://wa.me/905337774545?text=${whatsappMessage}`;

const services = [
  ["01", "Gelin Saçı ve Makyajı", "Düğün konsepti, gelinlik ve çekim planına göre saç ve makyaj hazırlığı planlanır.", "/assets/businesses/simay-sarikaya/service-makeup-01.jpg"],
  ["02", "Kına Hazırlığı", "Kına gecesi konsepti, kıyafet ve sahne ışığına uyumlu görünüm oluşturulur.", "/assets/businesses/simay-sarikaya/service-hair-01.jpg"],
  ["03", "Nişan Hazırlığı", "Nişan günü için daha zarif, fotoğrafa hazır ve dengeli bir saç-makyaj akışı hazırlanır.", "/assets/businesses/simay-sarikaya/grid-02.jpg"],
  ["04", "Davet Makyajı", "Özel davetler, doğum günü ve etkinlikler için sade ya da belirgin makyaj seçenekleri sunulur.", "/assets/businesses/simay-sarikaya/grid-03.jpg"],
  ["05", "Özel Gün Saç Tasarımı", "Topuz, dalga, fön ve konsept saç tasarımı gibi özel gün hazırlıkları planlanır.", "/assets/businesses/simay-sarikaya/pexels-kerimeveyik-22589552.jpg"],
];
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Simay Sarıkaya | Editoryal Hizmetler</title>
    <meta name="description" content="Editoryal servis menüsü yönünde Simay Sarıkaya hizmetler sayfası." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://example.com/style-lab/simay-editorial-menu/hizmetler/" />
  </head>
  <body>
    <div class="se-root">
      <header class="se-top">
        <div class="se-wrap se-top-row">
          <a class="se-logo" href={routes.home}><strong>Simay Sarıkaya</strong><span>Gelin Saçı ve Makyajı</span></a>
          <nav class="se-nav-d"><a href={routes.home}>Ana Sayfa</a><a href={routes.services}>Hizmetler</a><a href={routes.contact}>Randevu & İletişim</a><a class="se-icon" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a></nav>
          <div class="se-nav-m"><a class="se-icon" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a><details class="se-menu"><summary class="se-menu-btn" aria-label="Menü"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg></summary><nav class="se-menu-box"><a href={routes.home}>Ana Sayfa</a><a href={routes.services}>Hizmetler</a><a href={routes.contact}>Randevu & İletişim</a></nav></details></div>
        </div>
      </header>

      <main class="se-main">
        <div class="se-wrap">
          <p class="se-kicker">Hizmet Dosyaları</p>
          <h1 style="margin:.6rem 0 0;font-family:'Cormorant Garamond',serif;font-size:clamp(1.9rem,4.3vw,3.4rem);line-height:1.05;letter-spacing:0">Hizmetler</h1>
          <p style="margin:.8rem 0 0;max-width:62ch">Gelin, kına, nişan ve davet hazırlıkları için saç ve makyaj hizmetlerini tek sayfada inceleyin.</p>

          <section class="se-dossier">
            {
              services.map(([no, title, desc, img]) => (
                <article class="se-file">
                  <div class="se-file-copy">
                    <div class="se-row-h"><span class="se-no">{no}</span><h2>{title}</h2></div>
                    <p>{desc}</p>
                    <div class="se-actions">
                      <a class="se-btn se-btn-main" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp’tan Randevu Bilgisi Al</a>
                    </div>
                  </div>
                  <figure class="se-file-media">
                    <img src={img} alt={title} loading="lazy" onerror="this.style.display='none'" />
                  </figure>
                </article>
              ))
            }
          </section>

          <section class="se-main" style="padding:1rem 0 .2rem">
            <p class="se-kicker">Sık Sorulan Sorular</p>
            <div class="se-directory">
              <article class="se-entry"><span>Randevu bilgisi nasıl alınır?</span><strong>WhatsApp ile hızlıca</strong></article>
              <article class="se-entry"><span>Fiyat bilgisi nasıl veriliyor?</span><strong>Hizmet kapsamına göre</strong></article>
              <article class="se-entry"><span>Gelin, kına ve nişan ayrı alınabilir mi?</span><strong>Evet, ayrı planlanabilir</strong></article>
              <article class="se-entry"><span>Stüdyoya nasıl ulaşabilirim?</span><strong>Google Maps yol tarifi</strong></article>
            </div>
          </section>
        </div>
      </main>

      <footer class="se-footer">
        <div class="se-wrap">
          <div class="se-foot-grid">
            <section><h3>Marka</h3><ul><li>Simay Sarıkaya</li><li>Gelin Saçı ve Makyajı</li><li>Gaziosmanpaşa · İstanbul</li></ul></section>
            <section><h3>Sayfalar</h3><ul><li><a href={routes.home}>Ana Sayfa</a></li><li><a href={routes.services}>Hizmetler</a></li><li><a href={routes.contact}>Randevu & İletişim</a></li></ul></section>
            <section><h3>Hizmetler</h3><ul><li>Gelin Saçı ve Makyajı</li><li>Kına Hazırlığı</li><li>Nişan Hazırlığı</li><li>Davet Makyajı</li><li>Özel Gün Saç Tasarımı</li></ul></section>
            <section><h3>İletişim</h3><ul><li><a href="tel:+902126104545">+90 212 610 45 45</a></li><li><a href={whatsappUrl}>WhatsApp</a></li><li><a href="https://instagram.com/simaysarikayahairmakeup">Instagram</a></li><li><a href="https://maps.google.com/?q=Gaziosmanpasa+Istanbul">Yol Tarifi</a></li></ul></section>
          </div>
          <div class="se-credit"><strong>Web tasarım ve bakım: aydemirs.com</strong><span>Demo görseller temsili olarak kullanılmıştır. Yayın öncesi işletmenin kendi görselleriyle değiştirilebilir.</span></div>
        </div>
      </footer>

      <a class="se-float" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp hızlı erişim"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.85 11.85 0 0 0 12 0C5.37 0 .01 5.37 0 12c0 2.12.56 4.2 1.62 6.02L0 24l6.17-1.6A11.95 11.95 0 0 0 12 24h.01C18.63 24 24 18.63 24 12c0-3.2-1.25-6.2-3.48-8.52Z" /></svg></a>
    </div>
  </body>
</html>
